// ============================================================
// ДЕКОР
// ============================================================
function drawDecorItem(ctx, item, time) {
  ctx.save();
  ctx.translate(item.x, item.y);
  const s = item.scale || 1;
  ctx.scale(s, s);
  // seed2 кэшируется при создании объекта
  const seed2 = item.seed2 | 0;

  switch (item.kind) {
    case 'tree': {
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.beginPath(); ctx.ellipse(3, 3, 14, 12, 0, 0, TAU); ctx.fill();
      ctx.fillStyle = '#4a2a10';
      ctx.fillRect(-3, 0, 6, 14);
      ctx.fillStyle = '#2a6a2a';
      ctx.beginPath(); ctx.arc(-4, -6, 12, 0, TAU); ctx.fill();
      ctx.beginPath(); ctx.arc( 4, -6, 12, 0, TAU); ctx.fill();
      ctx.beginPath(); ctx.arc( 0,-14, 12, 0, TAU); ctx.fill();
      ctx.fillStyle = 'rgba(120,200,120,0.35)';
      ctx.beginPath(); ctx.arc(-3, -12, 6, 0, TAU); ctx.fill();
      break;
    }
    case 'autumnTree': {
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.beginPath(); ctx.ellipse(3, 3, 14, 12, 0, 0, TAU); ctx.fill();
      ctx.fillStyle = '#3a1e08';
      ctx.fillRect(-3, 0, 6, 14);
      ctx.fillStyle = '#c45a10';
      ctx.beginPath(); ctx.arc(-4, -6, 12, 0, TAU); ctx.fill();
      ctx.beginPath(); ctx.arc( 4, -6, 12, 0, TAU); ctx.fill();
      ctx.beginPath(); ctx.arc( 0,-14, 12, 0, TAU); ctx.fill();
      ctx.fillStyle = 'rgba(255,160,40,0.5)';
      ctx.beginPath(); ctx.arc(-3, -12, 6, 0, TAU); ctx.fill();
      break;
    }
    case 'pine': {
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.beginPath(); ctx.ellipse(3, 3, 12, 10, 0, 0, TAU); ctx.fill();
      ctx.fillStyle = '#3a2008';
      ctx.fillRect(-2.5, 4, 5, 12);
      ctx.fillStyle = '#1a4a1a';
      for (let i = 0; i < 3; i++) {
        const y = -2 - i * 8;
        const w = 14 - i * 3;
        ctx.beginPath();
        ctx.moveTo(-w, y);
        ctx.lineTo(0, y - 10);
        ctx.lineTo(w, y);
        ctx.closePath(); ctx.fill();
      }
      ctx.fillStyle = '#3a7a3a';
      ctx.beginPath();
      ctx.moveTo(-14, -2); ctx.lineTo(0, -12); ctx.lineTo(-2, -2);
      ctx.closePath(); ctx.fill();
      break;
    }
    case 'bush': {
      ctx.fillStyle = 'rgba(0,0,0,0.2)';
      ctx.beginPath(); ctx.ellipse(2, 3, 12, 8, 0, 0, TAU); ctx.fill();
      ctx.fillStyle = '#1e5e1e';
      ctx.beginPath(); ctx.arc(-5, 0, 8, 0, TAU); ctx.fill();
      ctx.beginPath(); ctx.arc( 5, 0, 8, 0, TAU); ctx.fill();
      ctx.beginPath(); ctx.arc( 0,-4, 9, 0, TAU); ctx.fill();
      ctx.fillStyle = 'rgba(100,180,100,0.4)';
      ctx.beginPath(); ctx.arc(-2, -6, 4, 0, TAU); ctx.fill();
      break;
    }
    case 'flower': {
      ctx.fillStyle = '#3a6a3a';
      ctx.fillRect(-0.8, 0, 1.6, 6);
      const cols = ['#ff5577', '#ffdd44', '#cc66ff', '#66ccff'];
      const c = cols[seed2 % cols.length];
      ctx.fillStyle = c;
      for (let i = 0; i < 5; i++) {
        const a = i * TAU / 5;
        ctx.beginPath();
        ctx.arc(Math.cos(a) * 2.4, -1 + Math.sin(a) * 2.4, 1.8, 0, TAU);
        ctx.fill();
      }
      ctx.fillStyle = '#ffee88';
      ctx.beginPath(); ctx.arc(0, -1, 1.4, 0, TAU); ctx.fill();
      break;
    }
    case 'mushroom': {
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.beginPath(); ctx.ellipse(1, 3, 6, 3, 0, 0, TAU); ctx.fill();
      ctx.fillStyle = '#f5f0e0';
      ctx.fillRect(-1.5, 0, 3, 7);
      ctx.fillStyle = '#c03030';
      ctx.beginPath();
      ctx.ellipse(0, 0, 7, 5, 0, Math.PI, 0);
      ctx.fill();
      ctx.fillStyle = '#fff';
      ctx.beginPath(); ctx.arc(-3, -2, 1, 0, TAU); ctx.fill();
      ctx.beginPath(); ctx.arc( 2, -1, 1.2, 0, TAU); ctx.fill();
      ctx.beginPath(); ctx.arc( 0, -3, 0.8, 0, TAU); ctx.fill();
      break;
    }
    case 'cactus': {
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.beginPath(); ctx.ellipse(2, 3, 6, 3, 0, 0, TAU); ctx.fill();
      ctx.fillStyle = '#3a7a3a';
      roundRect(ctx, -3, -12, 6, 18, 3); ctx.fill();
      roundRect(ctx, -9, -6, 5, 10, 2.5); ctx.fill();
      roundRect(ctx,  4, -9, 5, 12, 2.5); ctx.fill();
      ctx.fillStyle = '#4a9a4a';
      roundRect(ctx, -2, -10, 2, 12, 1); ctx.fill();
      ctx.fillStyle = '#f5f5c0';
      for (let i = 0; i < 6; i++) ctx.fillRect(-4 + (i % 2) * 7, -10 + i * 3, 0.8, 0.8);
      break;
    }
    case 'rock': {
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.beginPath(); ctx.ellipse(2, 3, 10, 6, 0, 0, TAU); ctx.fill();
      const r1 = seed2 > 5 ? '#7a7a7a' : '#8a8070';
      ctx.fillStyle = r1;
      ctx.beginPath();
      ctx.moveTo(-9, 4);
      ctx.lineTo(-7, -4);
      ctx.lineTo(-2, -7);
      ctx.lineTo(5, -6);
      ctx.lineTo(9, -1);
      ctx.lineTo(8, 4);
      ctx.closePath(); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,0.2)';
      ctx.beginPath();
      ctx.moveTo(-2, -7); ctx.lineTo(5, -6); ctx.lineTo(2, -3); ctx.closePath();
      ctx.fill();
      break;
    }
    case 'building': {
      const bw = 26 + seed2 * 3;
      const bh = 30 + seed2 * 4;
      const col = seed2 % 2 === 0 ? '#3a4a5a' : '#4a3a3a';
      ctx.fillStyle = 'rgba(0,0,0,0.35)';
      ctx.fillRect(-bw/2 + 3, -bh/2 + 4, bw, bh);
      ctx.fillStyle = col;
      ctx.fillRect(-bw/2, -bh/2, bw, bh);
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.fillRect(-bw/2, -bh/2, bw, 3);
      const rng2 = seededRand(item.seed * 1000 + 1);
      const cols = 3, rows = 4;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const lit = rng2() > 0.4;
          ctx.fillStyle = lit ? '#f5d878' : '#1a1a2a';
          ctx.fillRect(
            -bw/2 + 3 + c * (bw - 6) / cols,
            -bh/2 + 6 + r * (bh - 12) / rows,
            (bw - 6) / cols - 2, (bh - 12) / rows - 2
          );
        }
      }
      ctx.strokeStyle = 'rgba(255,255,255,0.15)';
      ctx.lineWidth = 1;
      ctx.strokeRect(-bw/2, -bh/2, bw, bh);
      break;
    }
    case 'sign': {
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.fillRect(1, 3, 2, 20);
      ctx.fillStyle = '#666';
      ctx.fillRect(-1, 0, 2, 20);
      ctx.fillStyle = '#2a6cd6';
      roundRect(ctx, -8, -12, 16, 12, 2); ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.2;
      ctx.strokeRect(-7, -11, 14, 10);
      ctx.fillStyle = '#fff';
      ctx.beginPath();
      ctx.moveTo(-5, -6); ctx.lineTo(3, -6); ctx.lineTo(3, -8);
      ctx.lineTo(6, -6); ctx.lineTo(3, -4); ctx.lineTo(3, -6);
      ctx.closePath(); ctx.fill();
      break;
    }
    case 'stand': {
      const sw = 60, sh = 26;
      ctx.fillStyle = 'rgba(0,0,0,0.3)';
      ctx.fillRect(-sw/2 + 4, -sh/2 + 5, sw, sh);
      ctx.fillStyle = '#4a4a52';
      ctx.fillRect(-sw/2, -sh/2, sw, sh);
      ctx.fillStyle = '#2a2a32';
      ctx.fillRect(-sw/2, -sh/2, sw, 5);
      const rng3 = seededRand(Math.floor(item.seed * 9000));
      const cols = ['#e74c3c', '#3498db', '#f1c40f', '#2ecc71', '#9b59b6', '#e67e22'];
      for (let i = 0; i < 40; i++) {
        ctx.fillStyle = cols[Math.floor(rng3() * cols.length)];
        ctx.beginPath();
        ctx.arc(-sw/2 + 5 + rng3() * (sw - 10), -sh/2 + 6 + rng3() * (sh - 12), 1.8, 0, TAU);
        ctx.fill();
      }
      break;
    }
    case 'light': {
      ctx.fillStyle = '#4a4a4a';
      ctx.fillRect(-2, -20, 4, 40);
      ctx.fillRect(-14, -22, 28, 4);
      ctx.fillStyle = '#222';
      roundRect(ctx, -12, -18, 7, 5, 1); ctx.fill();
      roundRect(ctx,   5, -18, 7, 5, 1); ctx.fill();
      const pulse = 0.6 + 0.4 * Math.sin(time * 0.003 + item.seed * 10);
      ctx.fillStyle = `rgba(255,240,180,${0.4 * pulse})`;
      ctx.beginPath(); ctx.arc(-8, -16, 8, 0, TAU); ctx.fill();
      ctx.beginPath(); ctx.arc( 8, -16, 8, 0, TAU); ctx.fill();
      ctx.fillStyle = `rgba(255,240,180,${0.95 * pulse})`;
      ctx.beginPath(); ctx.arc(-8, -16, 2.5, 0, TAU); ctx.fill();
      ctx.beginPath(); ctx.arc( 8, -16, 2.5, 0, TAU); ctx.fill();
      break;
    }
    case 'container': {
      const cw = 40, ch = 20;
      const rng4 = seededRand(Math.floor(item.seed * 7000));
      const cols = ['#c0392b', '#2980b9', '#27ae60', '#e67e22', '#8e44ad'];
      const c = cols[Math.floor(rng4() * cols.length)];
      ctx.fillStyle = 'rgba(0,0,0,0.3)';
      ctx.fillRect(-cw/2 + 4, -ch/2 + 5, cw, ch);
      ctx.fillStyle = c;
      ctx.fillRect(-cw/2, -ch/2, cw, ch);
      ctx.strokeStyle = 'rgba(0,0,0,0.35)';
      ctx.lineWidth = 1;
      for (let i = 1; i < 10; i++) {
        ctx.beginPath();
        ctx.moveTo(-cw/2 + i * cw / 10, -ch/2);
        ctx.lineTo(-cw/2 + i * cw / 10,  ch/2);
        ctx.stroke();
      }
      ctx.fillStyle = '#000';
      ctx.fillRect(-cw/2, -ch/2, 3, 3);
      ctx.fillRect( cw/2 - 3, -ch/2, 3, 3);
      ctx.fillRect(-cw/2,  ch/2 - 3, 3, 3);
      ctx.fillRect( cw/2 - 3,  ch/2 - 3, 3, 3);
      break;
    }
    case 'pipe': {
      const pl = 36;
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      roundRect(ctx, -pl/2 + 2, -2 + 2, pl, 8, 3); ctx.fill();
      ctx.fillStyle = '#8a8a8a';
      roundRect(ctx, -pl/2, -4, pl, 8, 3); ctx.fill();
      ctx.fillStyle = '#b0b0b0';
      roundRect(ctx, -pl/2, -4, pl, 2.5, 2); ctx.fill();
      ctx.fillStyle = '#666';
      roundRect(ctx, -pl/2 - 2, -5, 3, 10, 1); ctx.fill();
      roundRect(ctx,  pl/2 - 1, -5, 3, 10, 1); ctx.fill();
      break;
    }
    case 'palm': {
      ctx.fillStyle = 'rgba(0,0,0,0.3)';
      ctx.beginPath(); ctx.ellipse(3, 3, 14, 10, 0, 0, TAU); ctx.fill();
      ctx.fillStyle = '#7a4a20';
      ctx.beginPath();
      ctx.moveTo(-3, 8);
      ctx.quadraticCurveTo(-5, -2, 0, -10);
      ctx.lineTo(3, -10);
      ctx.quadraticCurveTo(1, -2, 3, 8);
      ctx.closePath(); ctx.fill();
      ctx.fillStyle = '#2a8a3a';
      for (let i = 0; i < 6; i++) {
        const a = (i / 6) * TAU + 0.3;
        ctx.save();
        ctx.translate(0, -10);
        ctx.rotate(a);
        ctx.beginPath();
        ctx.ellipse(10, 0, 12, 3.5, 0, 0, TAU);
        ctx.fill();
        ctx.restore();
      }
      ctx.fillStyle = '#3a9a4a';
      ctx.beginPath(); ctx.arc(0, -10, 4, 0, TAU); ctx.fill();
      break;
    }
    case 'neon': {
      const rng5 = seededRand(Math.floor(item.seed * 8000));
      const cols = ['#ff00ff', '#00ffff', '#ffff00', '#ff4080', '#40ff80'];
      const c = cols[Math.floor(rng5() * cols.length)];
      ctx.shadowColor = c;
      ctx.shadowBlur = 15;
      ctx.strokeStyle = c;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      if (seed2 % 3 === 0) {
        ctx.moveTo(-12, -8); ctx.lineTo(12, -8);
        ctx.moveTo(-12,  8); ctx.lineTo(12,  8);
      } else if (seed2 % 3 === 1) {
        ctx.arc(0, 0, 8, 0, TAU);
      } else {
        ctx.moveTo(-10, -10); ctx.lineTo(10, 10);
        ctx.moveTo(-10, 10);  ctx.lineTo(10, -10);
      }
      ctx.stroke();
      ctx.shadowBlur = 0;
      break;
    }
  }
  ctx.restore();
}

