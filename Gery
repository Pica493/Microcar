class Track {
  constructor(def) {
    this.name = def.name;
    this.roadWidth = def.roadWidth;
    this.laps = def.laps || 3;
    this.aiSkill = def.aiSkill || 0.85;
    this.points = def.points;
    this.theme = THEMES[def.theme] || THEMES.meadow;
    this.themeId = def.theme;

    this.segments = [];
    this.cumulative = [0];
    let total = 0;
    for (let i = 0; i < this.points.length; i++) {
      const a = this.points[i];
      const b = this.points[(i + 1) % this.points.length];
      const dx = b.x - a.x, dy = b.y - a.y;
      const len = Math.hypot(dx, dy);
      this.segments.push({ a, b, dx, dy, len, len2: len * len });
      total += len;
      this.cumulative.push(total);
    }
    this.totalLength = total;

    this.obstacles = (def.obstacles || []).map(o => {
      const t = OBSTACLE_TYPES[o.type] || OBSTACLE_TYPES.cone;
      return { ...o, ...t, _used: false, _respawn: 0 };
    });

    // Декор с кэшированным seed2 (не создаём Rand в каждом кадре)
    this.decor = [];
    const kinds = this.theme.decor;
    const rng = seededRand(def.points.length * 31 + 7);
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    for (const p of def.points) {
      minX = Math.min(minX, p.x); maxX = Math.max(maxX, p.x);
      minY = Math.min(minY, p.y); maxY = Math.max(maxY, p.y);
    }
    const pad = 300;
    minX -= pad; maxX += pad; minY -= pad; maxY += pad;

    for (let i = 0; i < 90; i++) {
      const x = minX + rng() * (maxX - minX);
      const y = minY + rng() * (maxY - minY);
      const p = this.project(x, y);
      if (p.dist < this.roadWidth * 0.85) continue;
      const kind = kinds[Math.floor(rng() * kinds.length)];
      const s = 0.85 + rng() * 0.55;
      const seed = rng();
      const seed2 = Math.floor(rng() * 10);
      this.decor.push({ x, y, kind, seed, scale: s, seed2 });
    }
  }

  project(x, y) {
    let bestDist = Infinity, bestProgress = 0, bestPx = 0, bestPy = 0;
    for (let i = 0; i < this.segments.length; i++) {
      const s = this.segments[i];
      let t = ((x - s.a.x) * s.dx + (y - s.a.y) * s.dy) / s.len2;
      t = clamp(t, 0, 1);
      const px = s.a.x + s.dx * t;
      const py = s.a.y + s.dy * t;
      const d = Math.hypot(x - px, y - py);
      if (d < bestDist) {
        bestDist = d;
        bestProgress = (this.cumulative[i] + t * s.len) / this.totalLength;
        bestPx = px; bestPy = py;
      }
    }
    return { dist: bestDist, progress: bestProgress, px: bestPx, py: bestPy };
  }

  getStart() {
    const a = this.points[0], b = this.points[1];
    return { x: a.x, y: a.y, angle: Math.atan2(b.y - a.y, b.x - a.x) };
  }

  getPath2D() {
    if (this._path) return this._path;
    const p = new Path2D();
    const n = this.points.length;
    const mid = (a, b) => ({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 });
    const m0 = mid(this.points[n - 1], this.points[0]);
    p.moveTo(m0.x, m0.y);
    for (let i = 0; i < n; i++) {
      const cur = this.points[i];
      const nxt = this.points[(i + 1) % n];
      const m = mid(cur, nxt);
      p.quadraticCurveTo(cur.x, cur.y, m.x, m.y);
    }
    this._path = p;
    return p;
  }
}

