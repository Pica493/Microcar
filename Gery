  cone:   { r: 16, solid: true,  bounce: 1.0, drag: 0 },
  tire:   { r: 24, solid: true,  bounce: 1.4, drag: 0 },
  barrel: { r: 22, solid: true,  bounce: 1.6, drag: 0 },
