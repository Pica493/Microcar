const CAR_R = 15;
const MAX_SPEED = 380;
const ENGINE = 700;
const BRAKE_FORCE = 900;
const DRAG = 1.4;
const GRIP = 9;
const TURN_RATE = 3.2;
const OFFROAD_DRAG = 4;
const DRIFT_GRIP = 3;

class Car {
  constructor(x, y, angle, color, isPlayer, name, num, bodyType) {
    this.x = x; this.y = y; this.angle = angle;
    this.vx = 0; this.vy = 0;
    this.color = color; this.isPlayer = isPlayer;
    this.name = name; this.num = num;
    this.bodyType = bodyType;

    this.lap = 0;
    this.progress = 0;
    this.prevProgress = 0;
    this.place = 1;
    this.finished = false;
    this.finishTime = 0;

    this.wheelAngle = 0;
    this.aiTargetIdx = 1;
    this.aiStuckTime = 0;
    this.boostTime = 0;
  }

  get speed() { return Math.hypot(this.vx, this.vy); }

  update(dt, throttle, brake, steer, handbrake, track) {
    const cos = Math.cos(this.angle), sin = Math.sin(this.angle);
    let vf =  this.vx * cos + this.vy * sin;
    let vs = -this.vx * sin + this.vy * cos;

    if (throttle > 0) vf += ENGINE * throttle * dt;
    if (brake > 0)   vf -= BRAKE_FORCE * brake * dt;
    if (this.boostTime > 0) { vf += 400 * dt; this.boostTime -= dt; }

    const grip = handbrake ? DRIFT_GRIP : GRIP;
    vf *= Math.exp(-DRAG * dt);
    vs *= Math.exp(-grip * dt);

    const maxSpeed = handbrake ? MAX_SPEED * 0.75 : MAX_SPEED * (this.boostTime > 0 ? 1.3 : 1);
    vf = clamp(vf, -maxSpeed * 0.4, maxSpeed);

    const steerFactor = clamp(Math.abs(vf) / 100, 0, 1);
    const dir = vf >= 0 ? 1 : -1;
    const turnMul = handbrake ? 1.4 : 1;
    this.angle += steer * TURN_RATE * steerFactor * dir * turnMul * dt;

    const nc = Math.cos(this.angle), ns = Math.sin(this.angle);
    this.vx = nc * vf - ns * vs;
    this.vy = ns * vf + nc * vs;

    this.x += this.vx * dt;
    this.y += this.vy * dt;

    const proj = track.project(this.x, this.y);
    const halfRoad = track.roadWidth / 2;
    if (proj.dist > halfRoad) {
      const k = Math.exp(-OFFROAD_DRAG * dt);
      this.vx *= k; this.vy *= k;
    }

    this.prevProgress = this.progress;
    this.progress = proj.progress;
    if (this.prevProgress > 0.75 && this.progress < 0.25) {
      this.lap++;
      if (this.isPlayer && !this.finished) Audio.lap();
    } else if (this.prevProgress < 0.25 && this.progress > 0.75) {
      if (this.lap > 0) this.lap--;
    }

    this.wheelAngle = lerp(this.wheelAngle, steer * 0.5, 1 - Math.exp(-12 * dt));
  }

  getRaceProgress() { return this.lap + this.progress; }

  draw(ctx) {
    ctx.save();
    ctx.translate(this.x + 3, this.y + 4);
    ctx.rotate(this.angle);
    ctx.fillStyle = 'rgba(0,0,0,0.35)';
    roundRect(ctx, -18, -10, 36, 20, 6);
    ctx.fill();
    ctx.restore();

    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.angle);

    if (this.boostTime > 0) {
      const fl = 14 + Math.sin(performance.now() / 40) * 4;
      const g = ctx.createLinearGradient(-18, 0, -18 - fl, 0);
      g.addColorStop(0, 'rgba(255,240,120,0.95)');
      g.addColorStop(0.5, 'rgba(255,140,60,0.75)');
      g.addColorStop(1, 'rgba(255,60,20,0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.moveTo(-18, -6);
      ctx.lineTo(-18 - fl, 0);
      ctx.lineTo(-18, 6);
      ctx.closePath(); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,200,0.9)';
      ctx.beginPath();
      ctx.moveTo(-17, -3);
      ctx.lineTo(-17 - fl * 0.5, 0);
      ctx.lineTo(-17, 3);
      ctx.closePath(); ctx.fill();
    }

    this.bodyType.draw(ctx, this.color, this.wheelAngle, this.num);

    ctx.restore();
  }
}

