  init() {
    this.canvas = document.getElementById('game');
    this.ctx = this.canvas.getContext('2d', { alpha: false });
    this.dpr = Math.min(2, window.devicePixelRatio || 1);
    this.resize();
    window.addEventListener('resize', () => this.resize());
    Input.init();

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        Audio.mute();
        if (this.state === 'racing' || this.state === 'countdown') this.pause();
      } else if (!Yandex.adShowing && !this._platformPaused) {
        Audio.unmute();
      }
    });
    window.addEventListener('blur', () => {
      Audio.mute();
      if (this.state === 'racing' || this.state === 'countdown') this.pause();
    });
    window.addEventListener('focus', () => {
      if (!Yandex.adShowing && !this._platformPaused && !document.hidden) Audio.unmute();
    });
  },

  setAdPaused(v) { this._adPaused = v; },
  setPlatformPaused(v) {
    this._platformPaused = v;
    if (v) {
      if (this.state === 'racing' || this.state === 'countdown') {
        this._pausedState = this.state;
        this.state = 'paused';
      }
    } else if (this.state === 'paused' && this._pausedState) {
      this.state = this._pausedState;
    }
  },

  resize() {
    const w = window.innerWidth, h = window.innerHeight;
    this.viewW = w; this.viewH = h;
    this.canvas.width = w * this.dpr;
    this.canvas.height = h * this.dpr;
    this.canvas.style.width = w + 'px';
    this.canvas.style.height = h + 'px';
  },

  startTrack(trackIdx) {
    Audio.init();
    Audio.resume();

    this.trackIdx = trackIdx;
    this.track = new Track(TRACKS[trackIdx]);
    Ambient.reset(this.track.theme);

    const start = this.track.getStart();
    const a = start.angle;
    const c = Math.cos(a), s = Math.sin(a);
    const nx = -s, ny = c;

    const colors = ['#e74c3c', '#2980b9', '#f39c12', '#27ae60'];
    const names  = ['Вы', 'ИИ-1', 'ИИ-2', 'ИИ-3'];
    const bodies = [CAR_TYPES[0], CAR_TYPES[1], CAR_TYPES[2], CAR_TYPES[3]];

    const grid = [
      { back: 100, side:  60 },
      { back: 100, side: -60 },
      { back:  35, side:  60 },
      { back:  35, side: -60 },
    ];

    this.cars = [];
    for (let i = 0; i < 4; i++) {
      const g = grid[i];
      const x = start.x + c * g.back + nx * g.side;
      const y = start.y + s * g.back + ny * g.side;
      const car = new Car(x, y, a, colors[i], i === 0, names[i], i + 1, bodies[i]);
      const proj = this.track.project(car.x, car.y);
      car.progress = car.prevProgress = proj.progress;
      this.cars.push(car);
    }
    this.player = this.cars[0];

    this.camera.x = this.player.x;
    this.camera.y = this.player.y;

    this.countdown = 3.5;
    this.raceTime = 0;
    this.finishDelay = 0;
    this._lastCountShown = -1;
    this._shake = 0;
    Particles.clear();

    this.state = 'countdown';
    Input.showTouch(true);
    UI.hide();
  },

  restart() { this.startTrack(this.trackIdx); },

  pause() {
    if (this.state !== 'racing' && this.state !== 'countdown') return;
    this._pausedState = this.state;
    this.state = 'paused';
    Input.showTouch(false);
    UI.showPause();
  },
  resume() {
    this.state = this._pausedState || 'racing';
    Input.showTouch(true);
    UI.hide();
  },

  update(dt) {
    this._time += dt;

    // Амбиент обновляется всегда, когда есть трасса — даже на паузе
    if (this.track) Ambient.update(dt, this.track.theme);

    if (this._adPaused || this._platformPaused) return;

    if (this.state === 'countdown') {
      this.countdown -= dt;
      const n = Math.ceil(this.countdown);
      if (n !== this._lastCountShown && n >= 0) {
        this._lastCountShown = n;
        if (n <= 3) Audio.countdown(n);
      }
      if (this.countdown <= 0) this.state = 'racing';
    }
    if (this.state === 'racing') this.raceTime += dt;

    if (this.state === 'racing' || this.state === 'countdown') {
      for (const car of this.cars) {
        if (car.finished) continue;
        let throttle = 0, brake = 0, steer = 0, handbrake = false;
        if (this.state === 'racing') {
          if (car.isPlayer) {
            throttle = Input.throttle;
            brake = Input.brake;
            steer = Input.steer;
            handbrake = Input.handbrake;
          } else {
            const cmd = AI.think(car, dt, this.track, this);
            throttle = cmd.throttle; brake = cmd.brake; steer = cmd.steer;
          }
        }
        car.update(dt, throttle, brake, steer, handbrake, this.track);
        this.resolveObstacles(car, dt);

        if (Math.abs(steer) > 0.5 && car.speed > 200 && Math.random() < 0.4) {
          Particles.add(
            car.x - Math.cos(car.angle) * 12,
            car.y - Math.sin(car.angle) * 12,
            rand(-25, 25), rand(-25, 25),
            0.45, 'rgba(200,200,200,0.65)', 3
          );
        }
      }
      for (let i = 0; i < this.cars.length; i++)
        for (let j = i + 1; j < this.cars.length; j++)
          this.resolveCarCollision(this.cars[i], this.cars[j]);
    }

    for (const o of this.track.obstacles) {
      if (o.type === 'boost' && o._used) {
        o._respawn -= dt;
        if (o._respawn <= 0) o._used = false;
      }
    }

    Particles.update(dt);
    this.updatePlaces();

    if (this.state === 'racing' && !this.player.finished) {
      if (this.player.lap >= this.track.laps) {
        this.player.finished = true;
        this.player.finishTime = this.raceTime;
        this.onFinish();
      }
    }

    if (this.state === 'finished') {
      this.finishDelay -= dt;
      if (this.finishDelay <= 0) {
        this.state = 'results';
        Input.showTouch(false);
        this.handleResults();
      }
    }

    const tx = this.player.x + Math.cos(this.player.angle) * 40;
    const ty = this.player.y + Math.sin(this.player.angle) * 40;
    const k = 1 - Math.exp(-6 * dt);
    this.camera.x = lerp(this.camera.x, tx, k);
    this.camera.y = lerp(this.camera.y, ty, k);

    if (this._shake > 0) this._shake = Math.max(0, this._shake - dt * 3);
  },

  resolveObstacles(car, dt) {
    for (const o of this.track.obstacles) {
      if (o._used) continue;
      const dx = car.x - o.x, dy = car.y - o.y;
      const d = Math.hypot(dx, dy);

      if (o.type === 'boost') {
        if (d < o.r + CAR_R * 0.5) {
          o._used = true;
          o._respawn = 4;
          car.boostTime = 1.2;
          Particles.burst(o.x, o.y, '#ffe066', 12, 200);
          if (car.isPlayer) Audio.boost();
        }
        continue;
      }
      if (o.type === 'oil') {
        if (d < o.r) {
          const k = Math.exp(-o.drag * dt);
          car.vx *= k; car.vy *= k;
        }
        continue;
      }
      const minD = CAR_R + o.r;
      if (d < minD && d > 0.01) {
        const nx = dx / d, ny = dy / d;
        const overlap = minD - d;
        car.x += nx * overlap;
        car.y += ny * overlap;
        const vn = car.vx * nx + car.vy * ny;
        if (vn < 0) {
          car.vx -= vn * nx * o.bounce;
          car.vy -= vn * ny * o.bounce;
          if (car.isPlayer) {
            this._shake = Math.min(1, this._shake + 0.15);
            Audio.hit();
          }
          Particles.burst(car.x, car.y, o.type === 'barrel' ? '#ff8c00' : '#aaa', 5, 130);
        }
      }
    }
  },

  resolveCarCollision(a, b) {
    const dx = b.x - a.x, dy = b.y - a.y;
    const d = Math.hypot(dx, dy);
    const minD = CAR_R * 2;
    if (d >= minD || d < 0.01) return;
    const nx = dx / d, ny = dy / d;
    const overlap = (minD - d) / 2;
    a.x -= nx * overlap; a.y -= ny * overlap;
    b.x += nx * overlap; b.y += ny * overlap;
    const rvx = b.vx - a.vx, rvy = b.vy - a.vy;
    const vn = rvx * nx + rvy * ny;
    if (vn < 0) {
      const imp = -vn * 0.7;
      a.vx -= nx * imp; a.vy -= ny * imp;
      b.vx += nx * imp; b.vy += ny * imp;
      if (a.isPlayer || b.isPlayer) {
        this._shake = Math.min(1, this._shake + 0.2);
        Audio.hit();
      }
      Particles.burst((a.x + b.x) / 2, (a.y + b.y) / 2, '#ffcc44', 6, 150);
    }
  },

  updatePlaces() {
    const sorted = [...this.cars].sort((a, b) => {
      if (a.finished !== b.finished) return a.finished ? -1 : 1;
      return b.getRaceProgress() - a.getRaceProgress();
    });
    sorted.forEach((c, i) => c.place = i + 1);
  },

  onFinish() {
    this.state = 'finished';
    this.finishDelay = 1.5;
    Audio.finish();
    Yandex.showFullscreenAd();
  },

  handleResults() {
    const p = this.player;
    Save.setBest(this.trackIdx, p.finishTime);
    if (p.place === 1) Save.unlock(this.trackIdx);
    UI.showResults();
  },

  draw() {
    const ctx = this.ctx;
    ctx.setTransform(this.dpr, 0, 0, this.dpr, 0, 0);

    const theme = this.track ? this.track.theme : THEMES.meadow;
    ctx.fillStyle = theme.bg;
    ctx.fillRect(0, 0, this.viewW, this.viewH);

    if (!this.track) return;

    const scale = clamp(Math.min(this.viewW, this.viewH) / 1000, 0.45, 1.15);
    const shakeX = this._shake > 0 ? rand(-1, 1) * this._shake * 8 : 0;
    const shakeY = this._shake > 0 ? rand(-1, 1) * this._shake * 8 : 0;

    ctx.save();
    ctx.translate(this.viewW / 2 + shakeX, this.viewH / 2 + shakeY);
    ctx.scale(scale, scale);
    ctx.translate(-this.camera.x, -this.camera.y);

    const halfW = this.viewW / (2 * scale) + 200;
    const halfH = this.viewH / (2 * scale) + 200;
    const viewL = this.camera.x - halfW, viewR = this.camera.x + halfW;
    const viewT = this.camera.y - halfH, viewB = this.camera.y + halfH;

    this.drawBgPattern(ctx, viewL, viewR, viewT, viewB);
    this.drawDecor(ctx, viewL, viewR, viewT, viewB);
    this.drawTrack(ctx);
    this.drawObstacles(ctx);
    Particles.draw(ctx);
    for (const car of this.cars) car.draw(ctx);

    ctx.restore();

    Ambient.draw(ctx);
    this.drawHUD(ctx);
  },

  drawBgPattern(ctx, left, right, top, bottom) {
    const theme = this.track.theme;
    const step = 70;
    const sx = Math.floor(left / step) * step;
    const sy = Math.floor(top / step) * step;
    ctx.fillStyle = theme.bg2;
    for (let y = sy; y < bottom; y += step) {
      for (let x = sx; x < right; x += step) {
        ctx.beginPath();
        ctx.arc(x + 30, y + 45, 2.5, 0, TAU);
        ctx.fill();
        if ((x / step + y / step) % 3 === 0) {
          ctx.beginPath();
          ctx.arc(x + 60, y + 20, 1.8, 0, TAU);
          ctx.fill();
        }
      }
    }
    if (theme === 'night') {
      const rng = seededRand(Math.floor((left + top) * 0.01));
      ctx.fillStyle = 'rgba(255,220,120,0.04)';
      for (let i = 0; i < 12; i++) {
        const x = left + rng() * (right - left);
        const y = top + rng() * (bottom - top);
        ctx.beginPath(); ctx.arc(x, y, 60 + rng() * 40, 0, TAU); ctx.fill();
      }
    }
  },

  drawDecor(ctx, left, right, top, bottom) {
    const t = this._time;
    for (const d of this.track.decor) {
      if (d.x < left || d.x > right || d.y < top || d.y > bottom) continue;
      drawDecorItem(ctx, d, t);
    }
  },

  drawTrack(ctx) {
    const track = this.track;
    const path = track.getPath2D();
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';

    ctx.save();
    ctx.translate(4, 5);
    ctx.strokeStyle = 'rgba(0,0,0,0.30)';
    ctx.lineWidth = track.roadWidth + 26;
    ctx.stroke(path);
    ctx.restore();

    ctx.strokeStyle = '#8a4a2a';
    ctx.lineWidth = track.roadWidth + 26;
    ctx.stroke(path);

    ctx.save();
    ctx.setLineDash([22, 22]);
    ctx.lineWidth = 6;
    ctx.strokeStyle = '#c0392b';
    ctx.stroke(path);
    ctx.setLineDash([]);
    ctx.restore();

    ctx.strokeStyle = '#4a4a4a';
    ctx.lineWidth = track.roadWidth;
    ctx.stroke(path);

    ctx.strokeStyle = 'rgba(255,255,255,0.045)';
    ctx.lineWidth = track.roadWidth - 40;
    ctx.stroke(path);

    ctx.strokeStyle = 'rgba(255,230,100,0.45)';
    ctx.lineWidth = 4;
    ctx.setLineDash([30, 30]);
    ctx.stroke(path);
    ctx.setLineDash([]);

    // Стартовая / финишная линия
    const start = track.getStart();
    ctx.save();
    ctx.translate(start.x, start.y);
    ctx.rotate(start.angle);
    const W = track.roadWidth;
    const cell = 24;
    const cols = Math.ceil(W / cell);
    for (let i = 0; i < cols; i++) {
      for (let j = 0; j < 4; j++) {
        const dark = (i + j) % 2 === 0;
        ctx.fillStyle = dark ? '#111' : '#f5f5f5';
        ctx.fillRect(-cell * 2 + j * cell, -W / 2 + i * cell, cell, cell);
      }
    }
    ctx.fillStyle = '#fff';
    ctx.fillRect(-cell * 2 - 3, -W / 2, 3, W);
    ctx.fillRect(cell * 2, -W / 2, 3, W);
    ctx.rotate(-start.angle);
    ctx.font = 'bold 22px system-ui';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.strokeStyle = 'rgba(0,0,0,0.85)';
    ctx.lineWidth = 4;
    ctx.strokeText('ФИНИШ', 0, -W / 2 - 30);
    ctx.fillStyle = '#fff';
    ctx.fillText('ФИНИШ', 0, -W / 2 - 30);
    ctx.font = '26px system-ui';
    ctx.fillText('🏁', 0, -W / 2 - 62);
    ctx.restore();
  },

  drawObstacles(ctx) {
    for (const o of this.track.obstacles) {
      if (o._used) continue;
      ctx.save();
      ctx.translate(o.x, o.y);
      ctx.fillStyle = 'rgba(0,0,0,0.3)';
      ctx.beginPath();
      ctx.ellipse(3, 4, o.r, o.r * 0.9, 0, 0, TAU);
      ctx.fill();

      if (o.type === 'cone') {
        ctx.fillStyle = '#e67e22';
        ctx.beginPath();
        ctx.moveTo(0, -o.r - 4);
        ctx.lineTo(-o.r, o.r);
        ctx.lineTo(o.r, o.r);
        ctx.closePath(); ctx.fill();
        ctx.fillStyle = '#fff';
        ctx.beginPath();
        ctx.moveTo(-o.r * 0.45, -o.r * 0.1);
        ctx.lineTo(o.r * 0.45, -o.r * 0.1);
        ctx.lineTo(o.r * 0.62, o.r * 0.25);
        ctx.lineTo(-o.r * 0.62, o.r * 0.25);
        ctx.closePath(); ctx.fill();
        ctx.fillStyle = '#c0621a';
        roundRect(ctx, -o.r, o.r - 5, o.r * 2, 6, 2); ctx.fill();

      } else if (o.type === 'tire') {
        ctx.fillStyle = '#1a1a1a';
        ctx.beginPath(); ctx.arc(0, 0, o.r, 0, TAU); ctx.fill();
        ctx.strokeStyle = '#333'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.arc(0, 0, o.r - 2, 0, TAU); ctx.stroke();
        ctx.strokeStyle = '#0a0a0a'; ctx.lineWidth = 2;
        for (let i = 0; i < 8; i++) {
          const a = i * TAU / 8;
          ctx.beginPath();
          ctx.moveTo(Math.cos(a) * o.r * 0.7, Math.sin(a) * o.r * 0.7);
          ctx.lineTo(Math.cos(a) * o.r, Math.sin(a) * o.r);
          ctx.stroke();
        }
        ctx.fillStyle = '#666';
        ctx.beginPath(); ctx.arc(0, 0, o.r * 0.35, 0, TAU); ctx.fill();
        ctx.fillStyle = '#888';
        ctx.beginPath(); ctx.arc(0, 0, o.r * 0.15, 0, TAU); ctx.fill();

      } else if (o.type === 'barrel') {
        const g = ctx.createRadialGradient(-o.r * 0.4, -o.r * 0.4, 2, 0, 0, o.r);
        g.addColorStop(0, '#e05040');
        g.addColorStop(1, '#8a2018');
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(0, 0, o.r, 0, TAU); ctx.fill();
        ctx.fillStyle = '#f5f5f5';
        ctx.beginPath();
        ctx.arc(0, 0, o.r * 0.85, 0, TAU);
        ctx.arc(0, 0, o.r * 0.65, 0, TAU, true);
        ctx.fill();
        ctx.strokeStyle = '#3a0f0a'; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.arc(0, 0, o.r, 0, TAU); ctx.stroke();
        ctx.fillStyle = '#8a2a20';
        ctx.beginPath(); ctx.arc(0, 0, o.r * 0.5, 0, TAU); ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,0.4)';
        ctx.beginPath(); ctx.arc(-o.r * 0.2, -o.r * 0.2, o.r * 0.22, 0, TAU); ctx.fill();

      } else if (o.type === 'oil') {
        const g = ctx.createRadialGradient(0, 0, o.r * 0.2, 0, 0, o.r);
        g.addColorStop(0, 'rgba(20,15,5,0.9)');
        g.addColorStop(0.7, 'rgba(40,30,10,0.75)');
        g.addColorStop(1, 'rgba(30,20,10,0)');
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(0, 0, o.r, 0, TAU); ctx.fill();
        const colors = ['rgba(120,80,200,0.45)', 'rgba(255,200,60,0.4)', 'rgba(80,220,180,0.4)'];
        for (let i = 0; i < 3; i++) {
          ctx.strokeStyle = colors[i];
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.arc(0, 0, o.r * (0.25 + i * 0.15), 0.3 + i * 1.2, 2.5 + i * 1.2);
          ctx.stroke();
        }

      } else if (o.type === 'boost') {
        const pulse = 0.7 + 0.3 * Math.sin(performance.now() / 120);
        ctx.globalAlpha = pulse * 0.7;
        ctx.fillStyle = 'rgba(255,220,80,0.5)';
        ctx.beginPath(); ctx.arc(0, 0, o.r * 1.5, 0, TAU); ctx.fill();
        ctx.globalAlpha = 1;
        ctx.fillStyle = '#f1c40f';
        ctx.beginPath();
        ctx.moveTo(-o.r * 0.7, -o.r * 0.6);
        ctx.lineTo(o.r * 0.2, 0);
        ctx.lineTo(-o.r * 0.7, o.r * 0.6);
        ctx.lineTo(-o.r * 0.3, o.r * 0.6);
        ctx.lineTo(o.r * 0.6, 0);
        ctx.lineTo(-o.r * 0.3, -o.r * 0.6);
        ctx.closePath(); ctx.fill();
        ctx.strokeStyle = '#8a6a00'; ctx.lineWidth = 2;
        ctx.stroke();
      }
      ctx.restore();
    }
  },

  drawHUD(ctx) {
    if (!this.player) return;
    ctx.save();

    ctx.fillStyle = 'rgba(0,0,0,0.55)';
    roundRect(ctx, 12, 12, 230, 120, 12);
    ctx.fill();
    ctx.strokeStyle = 'rgba(255,255,255,0.08)';
    ctx.lineWidth = 1; ctx.stroke();

    const curLap = Math.min(this.player.lap + 1, this.track.laps);
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 15px system-ui';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';
    ctx.fillText(`Круг: ${curLap}/${this.track.laps}`, 24, 24);

    ctx.font = 'bold 26px system-ui';
    ctx.fillStyle = this.player.place === 1 ? '#f1c40f' : '#fff';
    ctx.fillText(`${this.player.place}/${this.cars.length}`, 24, 46);

    ctx.font = '13px system-ui';
    ctx.fillStyle = 'rgba(255,255,255,0.75)';
    ctx.fillText(this.track.name, 24, 80);

    ctx.font = '14px system-ui';
    ctx.fillText(`${this.raceTime.toFixed(2)} с`, 24, 100);

    const barW = 206, barH = 6;
    ctx.fillStyle = 'rgba(255,255,255,0.15)';
    roundRect(ctx, 24, 122, barW, barH, 3);
    ctx.fill();
    ctx.fillStyle = this.player.speed > MAX_SPEED * 0.9 ? '#ff7676' : '#7ee8a2';
    roundRect(ctx, 24, 122, barW * clamp(this.player.speed / MAX_SPEED, 0, 1), barH, 3);
    ctx.fill();

    if (this.state === 'countdown') {
      ctx.fillStyle = 'rgba(0,0,0,0.4)';
      ctx.fillRect(0, 0, this.viewW, this.viewH);
      const n = Math.ceil(this.countdown);
      ctx.fillStyle = '#fff';
      ctx.font = 'bold 160px system-ui';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(n > 0 ? String(n) : 'GO!', this.viewW / 2, this.viewH / 2);
    }
    ctx.restore();
  },
};

// ============================================================
// UI
// ============================================================
const UI = {
  el: null,
  init() {
    this.el = document.getElementById('ui');
    this.el.addEventListener('click', e => {
      const btn = e.target.closest('[data-action]');
      if (!btn) return;
      this.handle(btn.dataset.action);
    });
  },
  show(html) {
    this.el.classList.add('active');
    this.el.innerHTML = `<div class="panel">${html}</div>`;
  },
  hide() {
    this.el.classList.remove('active');
    this.el.innerHTML = '';
  },
  handle(action) {
    if (action === 'campaign') return this.showCampaign();
    if (action === 'quick') {
      const idx = Math.min(Save.data.unlocked - 1, Math.floor(Math.random() * Save.data.unlocked));
      return Game.startTrack(idx);
    }
    if (action === 'menu') return this.showMenu();
    if (action === 'pause') return Game.pause();
    if (action === 'resume') return Game.resume();
    if (action === 'restart') return Game.restart();
    if (action === 'rewarded') return this.onRewardedClick();
    if (action === 'nextTrack') {
      const next = Game.trackIdx + 1;
      if (next < TRACKS.length) return Game.startTrack(next);
      return this.showCampaign();
    }
    if (action.startsWith('track:')) {
      const idx = parseInt(action.split(':')[1]);
      if (!Number.isInteger(idx) || idx < 0 || idx >= TRACKS.length) return;
      if (idx >= Save.data.unlocked) return;
      return Game.startTrack(idx);
    }
  },
  showMenu() {
    Game.state = 'menu';
    Input.showTouch(false);
    const unlocked = Save.data.unlocked;
    const total = TRACKS.length;
    const done = Object.keys(Save.data.best).length;
    this.show(`
      <div class="title">MINI RACERS</div>
      <div class="subtitle">Кампания: ${done} / ${total} трасс пройдено</div>
      <button class="btn primary" data-action="campaign">🏁 Кампания (${unlocked}/${total})</button>
      <button class="btn" data-action="quick">⚡ Быстрая игра</button>
      <button class="btn" data-action="rewarded">🎁 Бонус за рекламу</button>
      <div class="controls">
        Клавиатура: W/↑ — газ, S/↓ — тормоз, A/D — руль, Space — ручник, R — рестарт, Esc — пауза<br>
        Телефон: джойстик слева, кнопка GAS справа
      </div>
    `);
  },
  showCampaign() {
    Game.state = 'campaign';
    Input.showTouch(false);
    let cards = '';
    for (let i = 0; i < TRACKS.length; i++) {
      const t = TRACKS[i];
      const locked = i >= Save.data.unlocked;
      const best = Save.data.best[String(i)];
      const isCurrent = i === Save.data.unlocked - 1;
      cards += `
        <div class="trackCard ${locked ? 'locked' : ''} ${isCurrent ? 'current' : ''}"
             ${locked ? '' : `data-action="track:${i}"`}>
          <div class="num">ТРАССА ${i + 1}</div>
          <div class="name">${t.name}</div>
          <div class="best">${best ? '⏱ ' + best.toFixed(2) + ' с' : (locked ? '🔒 закрыто' : '— не пройдено')}</div>
          ${locked ? '<div class="lock">🔒</div>' : ''}
        </div>`;
    }
    this.show(`
      <div class="title" style="font-size:36px">КАМПАНИЯ</div>
      <div class="subtitle">Пройди трассу и займи 1-е место, чтобы открыть следующую</div>
      <div class="trackGrid">${cards}</div>
      <button class="btn small" data-action="menu">← В меню</button>
    `);
  },
  showPause() {
    this.show(`
      <div class="title" style="font-size:40px">ПАУЗА</div>
      <button class="btn primary" data-action="resume">▶ Продолжить</button>
      <button class="btn" data-action="restart">↻ Заново</button>
      <button class="btn" data-action="menu">⌂ В меню</button>
    `);
  },
  showResults() {
    const p = Game.player;
    const place = p.place;
    const time = p.finishTime.toFixed(2);
    const medals = ['🥇', '🥈', '🥉', '4️⃣'];
    const won = place === 1;
    const isLast = Game.trackIdx >= TRACKS.length - 1;
    const best = Save.data.best[String(Game.trackIdx)];
    const isRecord = best && Math.abs(best - p.finishTime) < 0.01;
    this.show(`
      <div class="title" style="font-size:40px">ФИНИШ</div>
      <div style="font-size:70px;margin:10px 0">${medals[place - 1] || '🏁'}</div>
      <div class="subtitle">${won ? '★ Победа!' : 'Место ' + place + ' из ' + Game.cars.length}</div>
      <div class="stat"><span>Трасса:</span><b>${Game.track.name}</b></div>
      <div class="stat"><span>Время:</span><b>${time} с${isRecord ? ' 🏆' : ''}</b></div>
      <div class="stat"><span>Круги:</span><b>${Game.track.laps}</b></div>
      ${won && !isLast ? '<div class="subtitle" style="color:#7ee8a2;margin-top:14px">🔓 Открыта новая трасса!</div>' : ''}
      ${won && isLast ? '<div class="subtitle" style="color:#f1c40f;margin-top:14px">🏆 Кампания пройдена!</div>' : ''}
      ${won && !isLast ? '<button class="btn primary" data-action="nextTrack">▶ Следующая трасса</button>' : ''}
      <button class="btn" data-action="restart">↻ Ещё раз</button>
      <button class="btn" data-action="menu">⌂ В меню</button>
    `);
  },
  onRewardedClick() {
    Yandex.showRewardedAd(rewarded => {
      if (rewarded) alert('Спасибо! Награда выдана.');
      else alert('Реклама не была показана.');
    });
  },
};

// ============================================================
// BOOT + LOOP
// ============================================================
let _lastT = 0;
function loop(now) {
  const dt = Math.min(0.05, (now - (_lastT || now)) / 1000);
  _lastT = now;

  if (Game.state !== 'menu' && Game.state !== 'paused' && Game.state !== 'results' && Game.state !== 'campaign') {
    Game.update(dt);
  } else if (Game.state === 'paused' && Game.track) {
    // Амбиент продолжает жить на паузе
    Game._time += dt;
    Ambient.update(dt, Game.track.theme);
  }

  if (Game.state !== 'menu' && Game.state !== 'campaign') {
    Game.draw();
  } else {
    const ctx = Game.ctx;
    ctx.setTransform(Game.dpr, 0, 0, Game.dpr, 0, 0);
    ctx.fillStyle = '#1a2a1a';
    ctx.fillRect(0, 0, Game.viewW, Game.viewH);
  }
  requestAnimationFrame(loop);
}

function boot() {
  try {
    Save.load();
    Game.init();
    UI.init();
    UI.showMenu();
    requestAnimationFrame(loop);
    Yandex.init();
    console.log('[Mini Racers] Ready. Трасс:', TRACKS.length);
  } catch (e) {
    console.error('[Mini Racers] Boot failed', e);
    document.body.innerHTML = '<pre style="padding:20px;color:#f88;font:14px monospace;white-space:pre-wrap">Ошибка запуска:\n' +
      (e && e.message) + '\n\n' + (e && e.stack) + '</pre>';
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', boot);
} else {
  boot();
}
</script>
</body>
</html>
