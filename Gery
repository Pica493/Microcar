// AI
// ============================================================
const AI = {
  think(car, dt, track, game) {
    const points = track.points;
    const target = points[car.aiTargetIdx];
    const next = points[(car.aiTargetIdx + 1) % points.length];
    const d = Math.hypot(target.x - car.x, target.y - car.y);
    if (d < 170) car.aiTargetIdx = (car.aiTargetIdx + 1) % points.length;

    let lookX = lerp(target.x, next.x, 0.35);
    let lookY = lerp(target.y, next.y, 0.35);

    let avoidX = 0, avoidY = 0;
    for (const other of game.cars) {
      if (other === car) continue;
      const dx = car.x - other.x, dy = car.y - other.y;
      const dd = Math.hypot(dx, dy);
      if (dd < 100 && dd > 0.1) {
        avoidX += (dx / dd) * (100 - dd) / 100;
        avoidY += (dy / dd) * (100 - dd) / 100;
      }
    }
    for (const o of track.obstacles) {
      if (!o.solid || o._used) continue;
      const dx = car.x - o.x, dy = car.y - o.y;
      const dd = Math.hypot(dx, dy);
      if (dd < 100 && dd > 0.1) {
        avoidX += (dx / dd) * (100 - dd) / 100 * 1.5;
        avoidY += (dy / dd) * (100 - dd) / 100 * 1.5;
      }
    }
    lookX += avoidX * 150;
    lookY += avoidY * 150;

    const desired = Math.atan2(lookY - car.y, lookX - car.x);
    let diff = desired - car.angle;
    while (diff > Math.PI) diff -= TAU;
    while (diff < -Math.PI) diff += TAU;

    const steer = clamp(diff * 2.5, -1, 1);
    let throttle = track.aiSkill;
    if (Math.abs(diff) > 1.0) throttle = 0.45;
    if (Math.abs(diff) > 1.6) throttle = 0.15;

    const proj = track.project(car.x, car.y);
    if (proj.dist > track.roadWidth * 0.55) throttle *= 0.65;

    if (car.speed < 30 && Math.abs(diff) > 1.5) {
      car.aiStuckTime += dt;
      if (car.aiStuckTime > 0.6) {
        car.aiStuckTime = 0;
        return { throttle: 0, brake: 1, steer: -steer };
      }
    } else car.aiStuckTime = 0;

    return { throttle, brake: 0, steer };
  }
};

