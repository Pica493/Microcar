<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover">
<title>Mini Racers</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{width:100%;height:100%;overflow:hidden;background:#111;
    font-family:system-ui,-apple-system,sans-serif;user-select:none;color:#fff;touch-action:none}
  #game{display:block;width:100%;height:100%}
  #ui{position:fixed;inset:0;display:none;align-items:center;justify-content:center;
    padding:20px;z-index:100;background:rgba(0,0,0,.78);backdrop-filter:blur(6px);overflow-y:auto}
  #ui.active{display:flex}
  .panel{max-width:640px;width:100%;text-align:center;padding:10px 0}
  .title{font-size:clamp(32px,8vw,56px);font-weight:900;letter-spacing:2px;
    background:linear-gradient(90deg,#ff7676,#ffce54,#7ee8a2,#66c2ff);
    -webkit-background-clip:text;background-clip:text;color:transparent;margin-bottom:8px}
  .subtitle{opacity:.65;margin-bottom:20px;font-size:15px}
  .btn{display:block;width:100%;padding:15px 24px;margin:8px 0;background:#2a3142;
    color:#fff;border:1px solid rgba(255,255,255,.1);border-radius:14px;font-size:16px;
    font-weight:700;cursor:pointer;font-family:inherit;transition:transform .08s,background .15s}
  .btn:active{transform:scale(.97);background:#3a4258}
  .btn.primary{background:linear-gradient(180deg,#4f8ef7,#2a6cd6);border-color:#4f8ef7}
  .btn.primary:active{background:linear-gradient(180deg,#3f7ee7,#1a5cc6)}
  .btn.small{padding:10px 16px;font-size:14px}
  .stat{display:flex;justify-content:space-between;padding:12px 16px;margin:6px 0;
    background:rgba(255,255,255,.05);border-radius:10px;font-size:15px}
  .stat b{color:#f1c40f}
  .controls{margin-top:20px;opacity:.5;font-size:12px;line-height:1.7}
  .trackGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));
    gap:10px;margin:16px 0}
  .trackCard{position:relative;padding:14px 12px;border-radius:12px;background:#1e2434;
    border:2px solid rgba(255,255,255,.08);cursor:pointer;text-align:left;
    transition:transform .1s,border-color .15s}
  .trackCard:active{transform:scale(.96)}
  .trackCard.locked{opacity:.45;cursor:not-allowed}
  .trackCard.current{border-color:#4f8ef7;box-shadow:0 0 0 1px #4f8ef7 inset}
  .trackCard .num{font-size:11px;opacity:.5;font-weight:800;letter-spacing:1px}
  .trackCard .name{font-weight:800;font-size:16px;margin:4px 0 6px;color:#fff}
  .trackCard .best{font-size:12px;color:#f1c40f;font-weight:700}
  .trackCard .lock{position:absolute;top:8px;right:10px;font-size:18px;opacity:.7}
  #touchLayer{position:fixed;inset:0;pointer-events:none;z-index:50;display:none}
  #touchLayer.active{display:block}
  #stick{position:absolute;left:30px;bottom:30px;width:140px;height:140px;border-radius:50%;
    background:rgba(255,255,255,.1);border:2px solid rgba(255,255,255,.3);pointer-events:auto}
  #stickKnob{position:absolute;left:50%;top:50%;width:60px;height:60px;margin:-30px 0 0 -30px;
    border-radius:50%;background:rgba(255,255,255,.4);border:2px solid rgba(255,255,255,.7);
    transition:transform .04s}
  #gasBtn{position:absolute;right:30px;bottom:30px;width:110px;height:110px;border-radius:50%;
    background:rgba(80,220,120,.4);border:2px solid rgba(255,255,255,.6);pointer-events:auto;
    display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px}
  #gasBtn.pressed{background:rgba(80,220,120,.75)}
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="ui"></div>
<div id="touchLayer">
  <div id="stick"><div id="stickKnob"></div></div>
  <div id="gasBtn">GAS</div>
</div>
<script>
'use strict';

// ============================================================
// УТИЛИТЫ
// ============================================================
const TAU = Math.PI * 2;
const clamp = (v, a, b) => v < a ? a : v > b ? b : v;
const lerp = (a, b, t) => a + (b - a) * t;
const rand = (a, b) => a + Math.random() * (b - a);
const dist = (x1, y1, x2, y2) => Math.hypot(x2 - x1, y2 - y1);

function roundRect(ctx, x, y, w, h, r) {
  r = Math.min(r, w / 2, h / 2);
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
}

function seededRand(seed) {
  let s = seed | 0;
  return () => {
    s = (s * 1664525 + 1013904223) | 0;
    return ((s >>> 0) % 100000) / 100000;
  };
}

function hexToRgb(hex) {
  if (typeof hex !== 'string') return { r: 200, g: 60, b: 60 };
  const m = /^#?([a-f\d]{3}|[a-f\d]{6})$/i.exec(hex);
  if (!m) return { r: 200, g: 60, b: 60 };
  let h = m[1];
  if (h.length === 3) h = h[0]+h[0]+h[1]+h[1]+h[2]+h[2];
  return {
    r: parseInt(h.substr(0,2),16),
    g: parseInt(h.substr(2,2),16),
    b: parseInt(h.substr(4,2),16),
  };
}
function lighten(hex, amt) {
  const c = hexToRgb(hex);
  return `rgb(${Math.min(255,c.r+amt)},${Math.min(255,c.g+amt)},${Math.min(255,c.b+amt)})`;
}
function darken(hex, amt) {
  const c = hexToRgb(hex);
  return `rgb(${Math.max(0,c.r-amt)},${Math.max(0,c.g-amt)},${Math.max(0,c.b-amt)})`;
}

// ============================================================
// АУДИО
// ============================================================
const Audio = {
  ctx: null, on: true, muted: false,
  init() {
    if (this.ctx) return;
    try { this.ctx = new (window.AudioContext || window.webkitAudioContext)(); }
    catch (e) { this.ctx = null; }
  },
  resume() { if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume().catch(() => {}); },
  mute() { this.muted = true; },
  unmute() { this.muted = false; },
  beep(freq, dur, type = 'sine', vol = 0.15) {
    if (!this.ctx || !this.on || this.muted) return;
    try {
      const t = this.ctx.currentTime;
      const osc = this.ctx.createOscillator();
      const g = this.ctx.createGain();
      osc.type = type; osc.frequency.value = freq;
      g.gain.setValueAtTime(vol, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      osc.connect(g); g.connect(this.ctx.destination);
      osc.start(t); osc.stop(t + dur + 0.05);
    } catch (e) {}
  },
  countdown(n) { this.beep(n > 0 ? 440 : 880, 0.2, 'square', 0.2); },
  finish() { [523, 659, 784, 1047].forEach((f, i) => setTimeout(() => this.beep(f, 0.2, 'triangle', 0.2), i * 100)); },
  lap() { this.beep(660, 0.1, 'sine', 0.15); setTimeout(() => this.beep(880, 0.15, 'sine', 0.15), 80); },
  hit() { this.beep(120, 0.08, 'square', 0.15); },
  boost() { this.beep(880, 0.1, 'sine', 0.15); setTimeout(() => this.beep(1320, 0.12, 'sine', 0.15), 60); },
};

// ============================================================
// YANDEX SDK
// ============================================================
const Yandex = {
  ysdk: null, ready: false, adShowing: false,
  _lastFullscreen: 0, _fullscreenCooldown: 60000,
  async init() {
    if (typeof YaGames === 'undefined') return;
    try {
      this.ysdk = await YaGames.init();
      this.ready = true;
      if (this.ysdk.features && this.ysdk.features.LoadingAPI) this.ysdk.features.LoadingAPI.ready();
      this.ysdk.on('game_api_pause', () => { Audio.mute(); Game.setPlatformPaused(true); this._gpStop(); });
      this.ysdk.on('game_api_resume', () => { Audio.unmute(); Game.setPlatformPaused(false); this._gpStart(); });
    } catch (e) {}
  },
  _gpStart() { if (this.ysdk?.features?.GameplayAPI) try { this.ysdk.features.GameplayAPI.start(); } catch(e){} },
  _gpStop()  { if (this.ysdk?.features?.GameplayAPI) try { this.ysdk.features.GameplayAPI.stop();  } catch(e){} },
  showFullscreenAd(onDone) {
    if (!this.ready || !this.ysdk?.adv) { onDone && onDone(false); return; }
    const now = Date.now();
    if (now - this._lastFullscreen < this._fullscreenCooldown) { onDone && onDone(false); return; }
    this._lastFullscreen = now;
    this.adShowing = true; Audio.mute(); Game.setAdPaused(true); this._gpStop();
    this.ysdk.adv.showFullscreenAdv({
      callbacks: {
        onClose: () => { this.adShowing = false; Audio.unmute(); Game.setAdPaused(false); this._gpStart(); onDone && onDone(true); },
        onError: () => { this.adShowing = false; Audio.unmute(); Game.setAdPaused(false); this._gpStart(); onDone && onDone(false); },
      },
    });
  },
  showRewardedAd(onReward) {
    if (!this.ready || !this.ysdk?.adv) { onReward && onReward(false); return; }
    this.adShowing = true; Audio.mute(); Game.setAdPaused(true); this._gpStop();
    let rewarded = false;
    this.ysdk.adv.showRewardedVideo({
      callbacks: {
        onRewarded: () => { rewarded = true; },
        onClose: () => { this.adShowing = false; Audio.unmute(); Game.setAdPaused(false); this._gpStart(); onReward && onReward(rewarded); },
        onError: () => { this.adShowing = false; Audio.unmute(); Game.setAdPaused(false); this._gpStart(); onReward && onReward(false); },
      },
    });
  },
};

// ============================================================
// СОХРАНЕНИЕ
// ============================================================
const Save = {
  KEY: 'mini_racers_campaign_v2',
  data: { unlocked: 1, best: {} },
  load() {
    try {
      const raw = localStorage.getItem(this.KEY);
      if (raw) {
        const p = JSON.parse(raw);
        this.data.unlocked = Math.max(1, Math.min(10, p.unlocked || 1));
        this.data.best = p.best || {};
      }
    } catch (e) {}
  },
  save() { try { localStorage.setItem(this.KEY, JSON.stringify(this.data)); } catch (e) {} },
  unlock(idx) { if (idx + 1 > this.data.unlocked) { this.data.unlocked = Math.min(10, idx + 1); this.save(); } },
  setBest(idx, time) {
    const k = String(idx);
    if (!this.data.best[k] || time < this.data.best[k]) { this.data.best[k] = time; this.save(); }
  },
};

// ============================================================
// КУЗОВА МАШИН
// ============================================================
function drawWheel(ctx, x, y, w, h, ang, rimColor) {
  ctx.save();
  ctx.translate(x, y);
  ctx.rotate(ang);
  ctx.fillStyle = 'rgba(0,0,0,0.35)';
  roundRect(ctx, -w/2 + 1, -h/2 + 1.5, w, h, 1.5); ctx.fill();
  ctx.fillStyle = '#0a0a0a';
  roundRect(ctx, -w/2, -h/2, w, h, 1.5); ctx.fill();
  if (rimColor) {
    ctx.fillStyle = rimColor;
    roundRect(ctx, -w/2 + 1, -h/2 + 0.8, w - 2, h - 1.6, 1); ctx.fill();
    ctx.fillStyle = 'rgba(0,0,0,0.55)';
    ctx.fillRect(-0.6, -h/2 + 0.8, 1.2, h - 1.6);
  }
  ctx.restore();
}

function drawNumberBadge(ctx, x, y, num) {
  ctx.fillStyle = 'rgba(0,0,0,0.72)';
  ctx.beginPath(); ctx.arc(x, y, 3.4, 0, TAU); ctx.fill();
  ctx.strokeStyle = 'rgba(255,255,255,0.55)';
  ctx.lineWidth = 0.6; ctx.stroke();
  ctx.fillStyle = '#fff';
  ctx.font = 'bold 5px system-ui';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(String(num), x, y + 0.4);
  ctx.textAlign = 'left';
  ctx.textBaseline = 'alphabetic';
}

// Спорткар
function drawBodySport(ctx, color, wheelAngle, num) {
  const W = 36, H = 17;
  const rearAxle = -W/2 + 5, frontAxle = W/2 - 7;

  drawWheel(ctx, rearAxle, -H/2 - 1, 8, 4.2, 0, '#999');
  drawWheel(ctx, rearAxle,  H/2 - 3.2, 8, 4.2, 0, '#999');
  drawWheel(ctx, frontAxle, -H/2 - 1, 8, 4.2, wheelAngle * 0.5, '#999');
  drawWheel(ctx, frontAxle,  H/2 - 3.2, 8, 4.2, wheelAngle * 0.5, '#999');

  const g = ctx.createLinearGradient(0, -H/2, 0, H/2);
  g.addColorStop(0, lighten(color, 55));
  g.addColorStop(0.45, color);
  g.addColorStop(0.55, color);
  g.addColorStop(1, darken(color, 55));
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.moveTo(-W/2, -H/2 + 2);
  ctx.lineTo(-W/2 + 2, -H/2);
  ctx.lineTo(W/2 - 7, -H/2);
  ctx.lineTo(W/2, -H/2 + 4);
  ctx.lineTo(W/2, H/2 - 4);
  ctx.lineTo(W/2 - 7, H/2);
  ctx.lineTo(-W/2 + 2, H/2);
  ctx.lineTo(-W/2, H/2 - 2);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = 'rgba(255,255,255,0.20)';
  roundRect(ctx, -W/2 + 3, -H/2 + 1.5, W - 8, 3, 1.5);
  ctx.fill();

  ctx.fillStyle = darken(color, 70);
  roundRect(ctx, -W/2 - 2, -H/2, 3.5, 3, 1); ctx.fill();
  roundRect(ctx, -W/2 - 2, H/2 - 3, 3.5, 3, 1); ctx.fill();
  ctx.fillStyle = '#111';
  roundRect(ctx, -W/2 - 2.5, -H/2 + 0.4, 2, H - 0.8, 1); ctx.fill();

  ctx.fillStyle = 'rgba(20,30,55,0.92)';
  roundRect(ctx, -3, -H/2 + 2, 10, H - 4, 3); ctx.fill();
  ctx.fillStyle = 'rgba(120,180,240,0.55)';
  roundRect(ctx, -2, -H/2 + 3, 8, H - 6, 2); ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,0.35)';
  ctx.beginPath();
  ctx.moveTo(-2, -H/2 + 3);
  ctx.lineTo(0, -H/2 + 3);
  ctx.lineTo(-2, H/2 - 3);
  ctx.closePath(); ctx.fill();

  ctx.fillStyle = 'rgba(20,30,55,0.8)';
  roundRect(ctx, -W/2 + 2, -H/2 + 3, 5, H - 6, 2); ctx.fill();

  ctx.fillStyle = 'rgba(0,0,0,0.55)';
  roundRect(ctx, W/2 - 9, -3, 4, 1.6, 0.8); ctx.fill();
  roundRect(ctx, W/2 - 9,  1.4, 4, 1.6, 0.8); ctx.fill();

  ctx.fillStyle = 'rgba(255,255,255,0.75)';
  ctx.fillRect(-W/2 + 3, -2.4, W - 7, 1.2);
  ctx.fillRect(-W/2 + 3,  1.2, W - 7, 1.2);

  ctx.fillStyle = '#ffedaa';
  roundRect(ctx, W/2 - 3.5, -H/2 + 2, 2.6, 3.2, 1.2); ctx.fill();
  roundRect(ctx, W/2 - 3.5, H/2 - 5.2, 2.6, 3.2, 1.2); ctx.fill();
  ctx.fillStyle = 'rgba(255,255,255,0.9)';
  ctx.fillRect(W/2 - 3, -H/2 + 2.5, 1.2, 1.2);
  ctx.fillRect(W/2 - 3, H/2 - 4.7, 1.2, 1.2);

  ctx.fillStyle = '#ff3333';
  roundRect(ctx, -W/2, -H/2 + 3, 2.2, 3, 1); ctx.fill();
  roundRect(ctx, -W/2, H/2 - 6, 2.2, 3, 1); ctx.fill();

  drawNumberBadge(ctx, W/2 - 12, 0, num);
}

// Масл-кар
function drawBodyMuscle(ctx, color, wheelAngle, num) {
  const W = 40, H = 21;
  const rearAxle = -W/2 + 6, frontAxle = W/2 - 8;

  drawWheel(ctx, rearAxle, -H/2 - 1.5, 9.5, 5, 0, '#777');
  drawWheel(ctx, rearAxle,  H/2 - 3.5, 9.5, 5, 0, '#777');
  drawWheel(ctx, frontAxle, -H/2 - 1.5, 8.5, 5, wheelAngle * 0.5, '#777');
  drawWheel(ctx, frontAxle,  H/2 - 3.5, 8.5, 5, wheelAngle * 0.5, '#777');

  const g = ctx.createLinearGradient(0, -H/2, 0, H/2);
  g.addColorStop(0, lighten(color, 60));
  g.addColorStop(0.42, color);
  g.addColorStop(0.58, color);
  g.addColorStop(1, darken(color, 60));
  ctx.fillStyle = g;
  roundRect(ctx, -W/2, -H/2, W, H, 4); ctx.fill();

  ctx.fillStyle = lighten(color, 20);
  roundRect(ctx, W/2 - 15, -4, 10, 8, 2); ctx.fill();
  ctx.fillStyle = 'rgba(0,0,0,0.65)';
  roundRect(ctx, W/2 - 13, -3, 6, 6, 1.5); ctx.fill();
  ctx.fillStyle = '#222';
  roundRect(ctx, W/2 - 12, -2, 4, 4, 1); ctx.fill();
  ctx.fillStyle = '#111';
  roundRect(ctx, W/2 - 4, -7, 3, 14, 1); ctx.fill();
  ctx.fillStyle = '#444';
  for (let i = 0; i < 4; i++) ctx.fillRect(W/2 - 3.6, -6 + i * 3.5, 2.2, 1.5);

  ctx.fillStyle = '#fff';
  ctx.fillRect(-W/2 + 2, -5, W - 4, 1.7);
  ctx.fillRect(-W/2 + 2,  3.3, W - 4, 1.7);

  ctx.fillStyle = 'rgba(20,30,55,0.92)';
  roundRect(ctx, -6, -H/2 + 3, 12, H - 6, 3); ctx.fill();
  ctx.fillStyle = 'rgba(120,180,240,0.5)';
  roundRect(ctx, -5, -H/2 + 4, 10, H - 8, 2); ctx.fill();
  ctx.fillStyle = 'rgba(20,30,55,0.75)';
  roundRect(ctx, -W/2 + 3, -H/2 + 4, 6, H - 8, 2); ctx.fill();

  ctx.fillStyle = '#222';
  roundRect(ctx, -4, -H/2 - 1.5, 4, 2, 0.8); ctx.fill();
  roundRect(ctx, -4,  H/2 - 0.5, 4, 2, 0.8); ctx.fill();

  ctx.fillStyle = '#e0e0e0';
  roundRect(ctx, W/2 - 5, -H/2 + 2, 4, 4, 1); ctx.fill();
  roundRect(ctx, W/2 - 5, H/2 - 6, 4, 4, 1); ctx.fill();
  ctx.fillStyle = '#ffedaa';
  roundRect(ctx, W/2 - 4.5, -H/2 + 2.6, 3, 2.8, 1); ctx.fill();
  roundRect(ctx, W/2 - 4.5, H/2 - 5.4, 3, 2.8, 1); ctx.fill();

  ctx.fillStyle = '#ff2b2b';
  roundRect(ctx, -W/2, -H/2 + 3, 2.6, 4.5, 1); ctx.fill();
  roundRect(ctx, -W/2, H/2 - 7.5, 2.6, 4.5, 1); ctx.fill();

  drawNumberBadge(ctx, -W/2 + 12, 0, num);
}

// Картинг
function drawBodyKart(ctx, color, wheelAngle, num) {
  const W = 32, H = 24;

  drawWheel(ctx, -W/2 + 1, -H/2 + 4, 11, 7, 0, '#aaa');
  drawWheel(ctx, -W/2 + 1,  H/2 - 4, 11, 7, 0, '#aaa');
  drawWheel(ctx, W/2 - 4, -H/2 + 3, 8, 6, wheelAngle * 0.5, '#aaa');
  drawWheel(ctx, W/2 - 4,  H/2 - 3, 8, 6, wheelAngle * 0.5, '#aaa');

  ctx.strokeStyle = '#222';
  ctx.lineWidth = 1.6;
  ctx.strokeRect(-W/2 + 4, -H/2 + 5, W - 10, H - 10);

  const gm = ctx.createLinearGradient(0, -H/2, 0, H/2);
  gm.addColorStop(0, '#5a5a5a');
  gm.addColorStop(1, '#222');
  ctx.fillStyle = gm;
  roundRect(ctx, -W/2 + 3, -H/2 + 3, 10, H - 6, 2); ctx.fill();
  ctx.fillStyle = '#666';
  roundRect(ctx, -W/2 + 4, -H/2 + 4, 8, H - 8, 1.5); ctx.fill();
  ctx.fillStyle = '#333';
  ctx.fillRect(-W/2 + 7, -H/2 + 4, 1.5, H - 8);
  ctx.fillRect(-W/2 + 9, -H/2 + 4, 1.5, H - 8);
  ctx.fillStyle = '#444';
  ctx.fillRect(-W/2 + 1, -3, 3, 1.5);
  ctx.fillRect(-W/2 + 1,  1.5, 3, 1.5);

  ctx.fillStyle = color;
  roundRect(ctx, -4, -H/2 + 5, 13, H - 10, 3); ctx.fill();

  ctx.fillStyle = color;
  roundRect(ctx, W/2 - 6, -H/2 + 7, 5, H - 14, 2); ctx.fill();
  ctx.fillStyle = darken(color, 40);
  roundRect(ctx, W/2 - 6, -H/2 + 7, 5, 2, 1); ctx.fill();

  ctx.fillStyle = '#111';
  ctx.beginPath(); ctx.arc(0, 0, 5.5, 0, TAU); ctx.fill();
  ctx.fillStyle = color;
  ctx.beginPath(); ctx.arc(0, 0, 4.8, 0, TAU); ctx.fill();
  ctx.fillStyle = 'rgba(20,30,55,0.85)';
  ctx.beginPath(); ctx.arc(1, 0, 3.4, -0.95, 0.95); ctx.lineTo(0, 0); ctx.closePath(); ctx.fill();
  ctx.fillStyle = '#fff';
  ctx.fillRect(-5, -0.9, 9.5, 1.8);

  ctx.strokeStyle = '#e0b080';
  ctx.lineWidth = 1.8;
  ctx.beginPath(); ctx.moveTo(-1, -3); ctx.lineTo(4, -2.5); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(-1,  3); ctx.lineTo(4,  2.5); ctx.stroke();
  ctx.strokeStyle = '#222';
  ctx.lineWidth = 1.4;
  ctx.beginPath(); ctx.arc(5, 0, 2.5, 0, TAU); ctx.stroke();

  // Номер — сдвинут ниже, чтобы не перекрывать шлем
  drawNumberBadge(ctx, 0, H/2 - 3, num);
}

// Ралли
function drawBodyRally(ctx, color, wheelAngle, num) {
  const W = 34, H = 19;
  const rearAxle = -W/2 + 5, frontAxle = W/2 - 7;

  drawWheel(ctx, rearAxle, -H/2 - 1, 8.5, 4.6, 0, '#888');
  drawWheel(ctx, rearAxle,  H/2 - 3.6, 8.5, 4.6, 0, '#888');
  drawWheel(ctx, frontAxle, -H/2 - 1, 8.5, 4.6, wheelAngle * 0.5, '#888');
  drawWheel(ctx, frontAxle,  H/2 - 3.6, 8.5, 4.6, wheelAngle * 0.5, '#888');

  const g = ctx.createLinearGradient(0, -H/2, 0, H/2);
  g.addColorStop(0, lighten(color, 50));
  g.addColorStop(0.5, color);
  g.addColorStop(1, darken(color, 50));
  ctx.fillStyle = g;
  roundRect(ctx, -W/2, -H/2, W, H, 4); ctx.fill();

  ctx.strokeStyle = '#1a1a1a';
  ctx.lineWidth = 1.6;
  ctx.beginPath();
  ctx.moveTo(-7, -H/2);
  ctx.lineTo(-7, -H/2 - 4);
  ctx.lineTo(7, -H/2 - 4);
  ctx.lineTo(7, -H/2);
  ctx.stroke();
  ctx.beginPath(); ctx.moveTo(-7, -H/2 - 2.5); ctx.lineTo(7, -H/2 - 2.5); ctx.stroke();
  ctx.beginPath(); ctx.moveTo(-7, -H/2 - 1); ctx.lineTo(7, -H/2 - 1); ctx.stroke();

  ctx.fillStyle = 'rgba(20,30,55,0.9)';
  roundRect(ctx, -6, -H/2 + 2, 15, H - 4, 2); ctx.fill();
  ctx.fillStyle = 'rgba(120,180,240,0.5)';
  roundRect(ctx, -5, -H/2 + 3, 13, H - 6, 1.5); ctx.fill();
  ctx.fillStyle = 'rgba(20,30,55,0.7)';
  roundRect(ctx, -W/2 + 2, -H/2 + 3, 5, H - 6, 2); ctx.fill();

  ctx.fillStyle = 'rgba(255,255,255,0.85)';
  ctx.fillRect(-W/2 + 2, -3.4, W - 4, 1.5);
  ctx.fillRect(-W/2 + 2,  1.9, W - 4, 1.5);

  ctx.fillStyle = '#ffedaa';
  roundRect(ctx, W/2 - 3.5, -H/2 + 2, 2.6, 3.4, 1); ctx.fill();
  roundRect(ctx, W/2 - 3.5, H/2 - 5.4, 2.6, 3.4, 1); ctx.fill();

  ctx.fillStyle = 'rgba(255,240,150,0.9)';
  ctx.beginPath(); ctx.arc(W/2 - 6, -4, 1.4, 0, TAU); ctx.fill();
  ctx.beginPath(); ctx.arc(W/2 - 6,  4, 1.4, 0, TAU); ctx.fill();

  ctx.fillStyle = '#ff2b2b';
  roundRect(ctx, -W/2, -H/2 + 3, 2.2, 3, 1); ctx.fill();
  roundRect(ctx, -W/2, H/2 - 6, 2.2, 3, 1); ctx.fill();

  drawNumberBadge(ctx, W/2 - 9, 0, num);
}

