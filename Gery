const Input = {
  keys: {},
  stickActive: false, stickId: null, stickDx: 0, stickDy: 0,
  gasPressed: false, isTouch: false,

  init() {
    window.addEventListener('keydown', e => {
      this.keys[e.code] = true;
      if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(e.code)) e.preventDefault();
      if (e.code === 'Escape' && (Game.state === 'racing' || Game.state === 'countdown')) Game.pause();
      if (e.code === 'KeyR' && (Game.state === 'racing' || Game.state === 'countdown')) Game.restart();
    });
    window.addEventListener('keyup', e => { this.keys[e.code] = false; });
    window.addEventListener('blur', () => { this.keys = {}; });

    this.isTouch = matchMedia('(pointer:coarse)').matches || 'ontouchstart' in window;

    const stick = document.getElementById('stick');
    const knob = document.getElementById('stickKnob');
    const gasBtn = document.getElementById('gasBtn');

    stick.addEventListener('touchstart', e => {
      e.preventDefault();
      this.stickId = e.changedTouches[0].identifier;
      this.stickActive = true;
      this.stickDx = 0; this.stickDy = 0;
    }, { passive: false });

    window.addEventListener('touchmove', e => {
      if (this.stickId === null) return;
      for (const t of e.changedTouches) {
        if (t.identifier !== this.stickId) continue;
        const r = stick.getBoundingClientRect();
        let dx = t.clientX - (r.left + r.width / 2);
        let dy = t.clientY - (r.top + r.height / 2);
        const m = Math.hypot(dx, dy);
        const max = r.width * 0.4;
        if (m > max) { dx = dx / m * max; dy = dy / m * max; }
        this.stickDx = dx / max;
        this.stickDy = dy / max;
        knob.style.transform = `translate(${dx}px,${dy}px)`;
      }
    }, { passive: false });

    const stickEnd = e => {
      for (const t of e.changedTouches) if (t.identifier === this.stickId) {
        this.stickId = null; this.stickActive = false;
        this.stickDx = 0; this.stickDy = 0;
        knob.style.transform = '';
      }
    };
    window.addEventListener('touchend', stickEnd);
    window.addEventListener('touchcancel', stickEnd);

    const gs = e => { e.preventDefault(); this.gasPressed = true; gasBtn.classList.add('pressed'); };
    const ge = () => { this.gasPressed = false; gasBtn.classList.remove('pressed'); };
    gasBtn.addEventListener('touchstart', gs, { passive: false });
    gasBtn.addEventListener('touchend', ge);
    gasBtn.addEventListener('touchcancel', ge);
  },

  showTouch(on) {
    document.getElementById('touchLayer').classList.toggle('active', on && this.isTouch);
  },

  get throttle() {
    if (this.keys.KeyW || this.keys.ArrowUp) return 1;
    if (this.gasPressed) return 1;
    if (this.stickActive && this.stickDy < -0.2) return 1;
    return 0;
  },
  get brake() {
    if (this.keys.KeyS || this.keys.ArrowDown) return 1;
    if (this.stickActive && this.stickDy > 0.5) return 1;
    return 0;
  },
  get steer() {
    let s = 0;
    if (this.keys.KeyA || this.keys.ArrowLeft)  s -= 1;
    if (this.keys.KeyD || this.keys.ArrowRight) s += 1;
    if (this.stickActive && Math.abs(this.stickDx) > 0.15) s = this.stickDx;
    return clamp(s, -1, 1);
  },
  get handbrake() { return !!this.keys.Space; },
};

