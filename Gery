const Particles = {
  list: [],
  add(x, y, vx, vy, life, color, size) {
    if (this.list.length > 250) return;
    this.list.push({ x, y, vx, vy, life, maxLife: life, color, size });
  },
  burst(x, y, color, n, speed) {
    for (let i = 0; i < n; i++) {
      const a = Math.random() * TAU;
      const s = rand(speed * 0.5, speed);
      this.add(x, y, Math.cos(a) * s, Math.sin(a) * s, rand(0.3, 0.6), color, rand(2, 4));
    }
  },
  update(dt) {
    for (let i = this.list.length - 1; i >= 0; i--) {
      const p = this.list[i];
      p.x += p.vx * dt; p.y += p.vy * dt;
      p.vx *= 0.94; p.vy *= 0.94;
      p.life -= dt;
      if (p.life <= 0) this.list.splice(i, 1);
    }
  },
  draw(ctx) {
    for (const p of this.list) {
      ctx.globalAlpha = clamp(p.life / p.maxLife, 0, 1);
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, TAU);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  },
  clear() { this.list.length = 0; },
};

// ============================================================
// АМБИЕНТ
// ============================================================
const Ambient = {
  list: [],
  reset(theme) {
    this.list.length = 0;
    if (!theme || !theme.ambient) return;
    const cfg = theme.ambient;
    for (let i = 0; i < cfg.count; i++) this.spawn(cfg);
  },
  spawn(cfg) {
    this.list.push({
      x: Math.random() * Math.max(1, window.innerWidth),
      y: Math.random() * Math.max(1, window.innerHeight),
      vx: rand(-cfg.speed * 0.5, cfg.speed * 0.5),
      vy: rand(cfg.speed * 0.5, cfg.speed),
      size: cfg.size * (0.7 + Math.random() * 0.6),
      rot: Math.random() * TAU,
      rotSpd: rand(-2, 2),
      life: 0,
      maxLife: rand(3, 6),
      cfg,
    });
  },
  update(dt, theme) {
    if (!theme || !theme.ambient) { this.list.length = 0; return; }
    const cfg = theme.ambient;
    while (this.list.length < cfg.count) this.spawn(cfg);
    const W = window.innerWidth, H = window.innerHeight;
    for (let i = this.list.length - 1; i >= 0; i--) {
      const p = this.list[i];
      p.life += dt;
      p.x += p.vx * dt + Math.sin(p.life * 2 + i) * 20 * dt;
      p.y += p.vy * dt;
      p.rot += p.rotSpd * dt;
      if (p.y > H + 20 || p.life > p.maxLife) {
        this.list.splice(i, 1);
        this.spawn(cfg);
      }
    }
  },
  draw(ctx) {
    if (!this.list.length) return;
    for (const p of this.list) {
      const alpha = clamp(Math.min(p.life * 2, p.maxLife - p.life) / 1, 0, 1);
      ctx.globalAlpha = alpha * 0.7;
      ctx.fillStyle = p.cfg.color;
      if (p.cfg.type === 'leaves') {
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.beginPath();
        ctx.ellipse(0, 0, p.size, p.size * 0.5, 0, 0, TAU);
        ctx.fill();
        ctx.restore();
      } else if (p.cfg.type === 'star') {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, TAU);
        ctx.fill();
        ctx.globalAlpha = alpha * 0.3;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * 3, 0, TAU);
        ctx.fill();
      } else if (p.cfg.type === 'smoke') {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * (1 + p.life * 0.3), 0, TAU);
        ctx.fill();
      } else {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, TAU);
        ctx.fill();
      }
    }
    ctx.globalAlpha = 1;
  }
};

