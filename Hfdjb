<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover">
<title>Mini Racers</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{width:100%;height:100%;overflow:hidden;background:#111;font-family:system-ui,-apple-system,sans-serif;user-select:none;color:#fff;touch-action:none}
  #game{display:block;width:100%;height:100%}
  #ui{position:fixed;inset:0;display:none;z-index:100;background:rgba(0,0,0,.85);backdrop-filter:blur(8px);overflow-y:auto;-webkit-overflow-scrolling:touch;touch-action:pan-y;overscroll-behavior:contain}
  #ui.active{display:block}
  .panel{max-width:720px;width:calc(100% - 32px);margin:20px auto;padding-bottom:40px;text-align:center}
  .title{font-size:clamp(32px,8vw,56px);font-weight:900;letter-spacing:2px;background:linear-gradient(90deg,#ff7676,#ffce54,#7ee8a2,#66c2ff);-webkit-background-clip:text;background-clip:text;color:transparent;margin-bottom:8px}
  .subtitle{opacity:.65;margin-bottom:20px;font-size:15px}
  .coinBar{display:inline-flex;align-items:center;gap:8px;padding:8px 16px;border-radius:20px;background:rgba(241,196,15,.12);border:1px solid rgba(241,196,15,.35);margin-bottom:16px;font-weight:800;color:#f1c40f;font-size:16px}
  .coinBar::before{content:'💰';font-size:18px}
  .btn{display:block;width:100%;padding:15px 24px;margin:8px 0;background:#2a3142;color:#fff;border:1px solid rgba(255,255,255,.1);border-radius:14px;font-size:16px;font-weight:700;cursor:pointer;font-family:inherit;transition:transform .08s,background .15s}
  .btn:active{transform:scale(.97);background:#3a4258}
  .btn.primary{background:linear-gradient(180deg,#4f8ef7,#2a6cd6);border-color:#4f8ef7}
  .btn.gold{background:linear-gradient(180deg,#f5c542,#d99e07);border-color:#f5c542;color:#1a1a1a}
  .btn.green{background:linear-gradient(180deg,#2ecc71,#229954);border-color:#2ecc71}
  .btn.small{padding:10px 16px;font-size:14px}
  .stat{display:flex;justify-content:space-between;padding:12px 16px;margin:6px 0;background:rgba(255,255,255,.05);border-radius:10px;font-size:15px}
  .stat b{color:#f1c40f}
  .controls{margin-top:20px;opacity:.55;font-size:12px;line-height:1.8;text-align:left;padding:12px 16px;background:rgba(255,255,255,.04);border-radius:10px}
  .controls b{color:#7ee8a2}
  .trackGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px;margin:16px 0}
  .trackCard{position:relative;padding:12px;border-radius:12px;background:#1e2434;border:2px solid rgba(255,255,255,.08);cursor:pointer;text-align:left;transition:transform .1s,border-color .15s}
  .trackCard:active{transform:scale(.96)}
  .trackCard.no-action{cursor:default}
  .trackCard.no-action:active{transform:none}
  .trackCard.locked{opacity:.45;cursor:not-allowed}
  .trackCard.locked:active{transform:none}
  .trackCard.current{border-color:#4f8ef7;box-shadow:0 0 0 1px #4f8ef7 inset}
  .trackCard .num{font-size:11px;opacity:.5;font-weight:800;letter-spacing:1px}
  .trackCard .name{font-weight:800;font-size:16px;margin:4px 0}
  .trackCard .best{font-size:12px;color:#f1c40f;font-weight:700}
  .trackCard .desc{font-size:11px;color:rgba(255,255,255,.55);margin-top:4px;line-height:1.3}
  .trackCard .lock{position:absolute;top:8px;right:10px;font-size:18px;opacity:.7}
  .trackCard .price{font-size:13px;font-weight:800;color:#f1c40f;margin-top:6px}
  .trackCard .price::before{content:'💰 '}
  .statsRow{display:flex;gap:3px;margin-top:6px}
  .statDot{width:100%;height:4px;border-radius:2px;background:rgba(255,255,255,.15)}
  .statDot.on{background:linear-gradient(90deg,#7ee8a2,#4f8ef7)}
  .colorRow{display:flex;gap:5px;margin-top:8px;flex-wrap:wrap}
  .colorDot{width:20px;height:20px;border-radius:50%;border:2px solid rgba(255,255,255,.3);cursor:pointer;transition:transform .1s;position:relative}
  .colorDot:active{transform:scale(.9)}
  .colorDot.active{border-color:#fff;box-shadow:0 0 0 2px rgba(255,255,255,.5)}
  .colorDot.preview{border-color:#f1c40f;box-shadow:0 0 0 2px #f1c40f}
  .colorDot.locked::after{content:'';position:absolute;inset:0;background:rgba(0,0,0,.5);border-radius:50%}
  .colorDot.locked::before{content:'🔒';position:absolute;inset:0;font-size:10px;display:flex;align-items:center;justify-content:center;z-index:1}
  .buyRow{display:flex;gap:6px;margin-top:8px;align-items:center;flex-wrap:wrap}
  .buyHint{font-size:11px;color:#f1c40f;flex:1}
  .codeDisplay{font-family:'Courier New',monospace;font-size:clamp(28px,10vw,42px);font-weight:900;letter-spacing:10px;color:#7ee8a2;background:rgba(126,232,162,.1);border:2px dashed rgba(126,232,162,.4);padding:20px 10px;border-radius:14px;margin:20px 0;text-align:center;cursor:pointer;user-select:all}
  .codeDisplay:active{background:rgba(126,232,162,.2)}
  .status{padding:10px;border-radius:10px;margin:10px 0;font-size:14px}
  .status.waiting{background:rgba(241,196,15,.15);color:#f1c40f}
  .status.ok{background:rgba(126,232,162,.15);color:#7ee8a2}
  .status.err{background:rgba(255,118,118,.15);color:#ff7676}
  .spinner{display:inline-block;width:16px;height:16px;border:2px solid rgba(255,255,255,.2);border-top-color:#4f8ef7;border-radius:50%;animation:spin 1s linear infinite;vertical-align:middle;margin-right:8px}
  @keyframes spin{to{transform:rotate(360deg)}}
  #touchLayer{position:fixed;inset:0;pointer-events:none;z-index:50;display:none}
  #touchLayer.active{display:block}
  #stick{position:absolute;left:30px;bottom:30px;width:140px;height:140px;border-radius:50%;background:rgba(255,255,255,.1);border:2px solid rgba(255,255,255,.3);pointer-events:auto}
  #stickKnob{position:absolute;left:50%;top:50%;width:60px;height:60px;margin:-30px 0 0 -30px;border-radius:50%;background:rgba(255,255,255,.4);border:2px solid rgba(255,255,255,.7);transition:transform .04s}
  #gasBtn{position:absolute;right:30px;bottom:30px;width:110px;height:110px;border-radius:50%;background:rgba(80,220,120,.4);border:2px solid rgba(255,255,255,.6);pointer-events:auto;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px}
  #gasBtn.pressed{background:rgba(80,220,120,.75)}
  #pauseBtn{position:fixed;top:12px;right:12px;width:48px;height:48px;border-radius:50%;background:rgba(0,0,0,.6);border:2px solid rgba(255,255,255,.35);color:#fff;font-size:20px;font-weight:900;cursor:pointer;z-index:60;display:none;align-items:center;justify-content:center;backdrop-filter:blur(6px);font-family:inherit}
  #pauseBtn.show{display:flex}
  #pauseBtn:active{transform:scale(.92);background:rgba(0,0,0,.85)}
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="ui"></div>
<button id="pauseBtn" aria-label="Пауза">⏸</button>
<div id="touchLayer"><div id="stick"><div id="stickKnob"></div></div><div id="gasBtn">GAS</div></div>
<script>
'use strict';

const TAU=Math.PI*2;
const clamp=(v,a,b)=>v<a?a:v>b?b:v;
const lerp=(a,b,t)=>a+(b-a)*t;
const rand=(a,b)=>a+Math.random()*(b-a);
const dist=(x1,y1,x2,y2)=>Math.hypot(x2-x1,y2-y1);
function roundRect(ctx,x,y,w,h,r){r=Math.min(r,w/2,h/2);ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}
function seededRand(seed){let s=seed|0;return()=>{s=(s*1664525+1013904223)|0;return((s>>>0)%100000)/100000;};}
function hexToRgb(hex){if(typeof hex!=='string')return{r:200,g:60,b:60};const m=/^#?([a-f\d]{3}|[a-f\d]{6})$/i.exec(hex);if(!m)return{r:200,g:60,b:60};let h=m[1];if(h.length===3)h=h[0]+h[0]+h[1]+h[1]+h[2]+h[2];return{r:parseInt(h.substr(0,2),16),g:parseInt(h.substr(2,2),16),b:parseInt(h.substr(4,2),16)};}
const lighten=(h,a)=>{const c=hexToRgb(h);return`rgb(${Math.min(255,c.r+a)},${Math.min(255,c.g+a)},${Math.min(255,c.b+a)})`;};
const darken=(h,a)=>{const c=hexToRgb(h);return`rgb(${Math.max(0,c.r-a)},${Math.max(0,c.g-a)},${Math.max(0,c.b-a)})`;};

const Audio={
  ctx:null,on:true,muted:false,
  init(){if(this.ctx)return;try{this.ctx=new(window.AudioContext||window.webkitAudioContext)();}catch(e){this.ctx=null;}},
  resume(){if(this.ctx&&this.ctx.state==='suspended')this.ctx.resume().catch(()=>{});},
  mute(){this.muted=true;},unmute(){this.muted=false;},
  beep(f,d,t='sine',v=0.15){if(!this.ctx||!this.on||this.muted)return;try{const n=this.ctx.currentTime,o=this.ctx.createOscillator(),g=this.ctx.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(v,n);g.gain.exponentialRampToValueAtTime(0.0001,n+d);o.connect(g);g.connect(this.ctx.destination);o.start(n);o.stop(n+d+0.05);}catch(e){}},
  countdown(n){this.beep(n>0?440:880,0.2,'square',0.2);},
  finish(){[523,659,784,1047].forEach((f,i)=>setTimeout(()=>this.beep(f,0.2,'triangle',0.2),i*100));},
  lap(){this.beep(660,0.1);setTimeout(()=>this.beep(880,0.15),80);},
  hit(){this.beep(120,0.08,'square',0.15);},
  buy(){[660,880,1320].forEach((f,i)=>setTimeout(()=>this.beep(f,0.15,'triangle',0.2),i*80));},
  connect(){[440,660,880].forEach((f,i)=>setTimeout(()=>this.beep(f,0.15,'sine',0.2),i*120));},
  teleport(){[880,660,440,330].forEach((f,i)=>setTimeout(()=>this.beep(f,0.15,'sine',0.2),i*80));},
};

const Save={
  KEY:'mini_racers_v7',
  data:{unlocked:1,best:{},coins:0,ownedCars:['rocket'],currentCar:'rocket',carColors:{},carCurrentColor:{}},
  _sanitize(){
    if(!this.data||typeof this.data!=='object')this.data={};
    if(typeof this.data.unlocked!=='number')this.data.unlocked=1;
    this.data.unlocked=clamp(this.data.unlocked|0,1,10);
    if(!this.data.best||typeof this.data.best!=='object'||Array.isArray(this.data.best))this.data.best={};
    if(typeof this.data.coins!=='number')this.data.coins=0;
    this.data.coins=Math.max(0,this.data.coins|0);
    if(!Array.isArray(this.data.ownedCars)||!this.data.ownedCars.length)this.data.ownedCars=['rocket'];
    if(typeof this.data.currentCar!=='string'||this.data.ownedCars.indexOf(this.data.currentCar)<0)this.data.currentCar='rocket';
    if(!this.data.carColors||typeof this.data.carColors!=='object'||Array.isArray(this.data.carColors))this.data.carColors={};
    if(!this.data.carCurrentColor||typeof this.data.carCurrentColor!=='object'||Array.isArray(this.data.carCurrentColor))this.data.carCurrentColor={};
    for(const k in this.data.carColors){
      if(!Array.isArray(this.data.carColors[k]))this.data.carColors[k]=[];
      else this.data.carColors[k]=this.data.carColors[k].filter(c=>typeof c==='string');
    }
    for(const k in this.data.carCurrentColor){
      if(typeof this.data.carCurrentColor[k]!=='string')delete this.data.carCurrentColor[k];
    }
  },
  load(){
    try{
      const raw=localStorage.getItem(this.KEY)||localStorage.getItem('mini_racers_v6')||localStorage.getItem('mini_racers_v5');
      if(raw){const p=JSON.parse(raw);if(p&&typeof p==='object')Object.assign(this.data,p);}
    }catch(e){console.warn('save load',e);}
    this._sanitize();
  },
  save(){try{this._sanitize();localStorage.setItem(this.KEY,JSON.stringify(this.data));}catch(e){}},
  unlock(idx){if(idx+1>this.data.unlocked){this.data.unlocked=Math.min(10,idx+1);this.save();}},
  setBest(idx,time){const k=String(idx);if(!this.data.best[k]||time<this.data.best[k]){this.data.best[k]=time;this.save();return true;}return false;},
  getColor(carId){const c=this.data.carCurrentColor[carId];return typeof c==='string'?c:null;},
  ownsColor(carId,color){const arr=this.data.carColors[carId];return Array.isArray(arr)&&arr.indexOf(color)>=0;},
  buyColor(carId,color,price){
    if(typeof color!=='string')return false;
    if(this.data.coins<price)return false;
    this.data.coins-=price;
    if(!Array.isArray(this.data.carColors[carId]))this.data.carColors[carId]=[];
    if(this.data.carColors[carId].indexOf(color)<0)this.data.carColors[carId].push(color);
    this.data.carCurrentColor[carId]=color;
    this.save();return true;
  },
  setColor(carId,color){if(typeof color!=='string')return;this.data.carCurrentColor[carId]=color;this.save();},
};
const CAR_COLORS=['#e74c3c','#3498db','#f1c40f','#2ecc71','#9b59b6','#e67e22','#1abc9c','#ecf0f1','#34495e','#ff69b4'];
const COLOR_PRICE=100;
const REWARD_AD_COINS=200;

/* ============ Рисование деталей ============ */
function drawWheel(ctx,x,y,w,h,ang,rim,style){
  ctx.save();ctx.translate(x,y);ctx.rotate(ang);
  ctx.fillStyle='rgba(0,0,0,0.4)';roundRect(ctx,-w/2+1,-h/2+1.5,w,h,1.6);ctx.fill();
  ctx.fillStyle='#0a0a0a';roundRect(ctx,-w/2,-h/2,w,h,1.6);ctx.fill();
  if(style==='spoke'){
    ctx.strokeStyle=rim||'#aaa';ctx.lineWidth=0.9;
    for(let i=0;i<4;i++){const a=i*Math.PI/4;ctx.beginPath();ctx.moveTo(-Math.cos(a)*w/2*0.85,-Math.sin(a)*h/2*0.85);ctx.lineTo(Math.cos(a)*w/2*0.85,Math.sin(a)*h/2*0.85);ctx.stroke();}
  } else if(style==='hub'){
    ctx.fillStyle=rim||'#aaa';ctx.beginPath();ctx.arc(0,0,Math.min(w,h)*0.28,0,TAU);ctx.fill();
  } else if(style==='tread'){
    ctx.strokeStyle='rgba(70,70,70,0.95)';ctx.lineWidth=0.7;
    for(let i=-1;i<=1;i++){ctx.beginPath();ctx.moveTo(-w/2,i*h/3);ctx.lineTo(w/2,i*h/3);ctx.stroke();}
  }
  if(rim&&style!=='hub'){ctx.fillStyle=rim;roundRect(ctx,-w/2+1,-h/2+0.9,w-2,h-1.8,1);ctx.fill();}
  ctx.restore();
}
function drawNumberBadge(ctx,x,y,num){ctx.fillStyle='rgba(0,0,0,0.75)';ctx.beginPath();ctx.arc(x,y,3.6,0,TAU);ctx.fill();ctx.strokeStyle='rgba(255,255,255,0.6)';ctx.lineWidth=0.7;ctx.stroke();ctx.fillStyle='#fff';ctx.font='bold 5px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(String(num),x,y+0.4);ctx.textAlign='left';ctx.textBaseline='alphabetic';}
function drawWindowGlass(ctx,x,y,w,h,r){const g=ctx.createLinearGradient(x,y,x,y+h);g.addColorStop(0,'rgba(80,120,180,0.9)');g.addColorStop(0.5,'rgba(20,30,55,0.92)');g.addColorStop(1,'rgba(10,18,35,0.95)');ctx.fillStyle=g;roundRect(ctx,x,y,w,h,r);ctx.fill();ctx.fillStyle='rgba(255,255,255,0.35)';ctx.beginPath();ctx.moveTo(x+1,y+1);ctx.lineTo(x+w*0.4,y+1);ctx.lineTo(x+w*0.1,y+h-1);ctx.lineTo(x+1,y+h-1);ctx.closePath();ctx.fill();}
function drawHeadlights(ctx,x,y,w,h,color){color=color||'#ffedaa';ctx.fillStyle='#c8c8c8';roundRect(ctx,x-0.5,y-0.5,w+1,h+1,h/2);ctx.fill();ctx.fillStyle=color;roundRect(ctx,x,y,w,h,h/2);ctx.fill();ctx.fillStyle='rgba(255,255,255,0.95)';ctx.fillRect(x+w*0.2,y+h*0.25,w*0.3,h*0.3);}
function drawTaillights(ctx,x,y,w,h){ctx.fillStyle='#3a0a0a';roundRect(ctx,x-0.5,y-0.5,w+1,h+1,h/2);ctx.fill();ctx.fillStyle='#ff2b2b';roundRect(ctx,x,y,w,h,h/2);ctx.fill();ctx.fillStyle='rgba(255,150,150,0.7)';ctx.fillRect(x+w*0.2,y+h*0.25,w*0.5,h*0.3);}

function drawBodySport(ctx,color,wa,num,accent){const W=36,H=17;
  drawWheel(ctx,-W/2+5,-H/2-1,8,4.2,0,'#aaa','tread');
  drawWheel(ctx,-W/2+5,H/2-3.2,8,4.2,0,'#aaa','tread');
  drawWheel(ctx,W/2-7,-H/2-1,8,4.2,wa*0.5,'#aaa','spoke');
  drawWheel(ctx,W/2-7,H/2-3.2,8,4.2,wa*0.5,'#aaa','spoke');
  const g=ctx.createLinearGradient(0,-H/2,0,H/2);g.addColorStop(0,lighten(color,60));g.addColorStop(0.45,color);g.addColorStop(0.55,color);g.addColorStop(1,darken(color,60));ctx.fillStyle=g;
  ctx.beginPath();ctx.moveTo(-W/2,-H/2+2);ctx.lineTo(-W/2+2,-H/2);ctx.lineTo(W/2-7,-H/2);ctx.lineTo(W/2,-H/2+4);ctx.lineTo(W/2,H/2-4);ctx.lineTo(W/2-7,H/2);ctx.lineTo(-W/2+2,H/2);ctx.lineTo(-W/2,H/2-2);ctx.closePath();ctx.fill();
  ctx.fillStyle='rgba(255,255,255,0.22)';roundRect(ctx,-W/2+3,-H/2+1.5,W-8,2.5,1.5);ctx.fill();
  ctx.fillStyle=darken(color,70);roundRect(ctx,-W/2-2,-H/2,3.5,3,1);ctx.fill();roundRect(ctx,-W/2-2,H/2-3,3.5,3,1);ctx.fill();
  ctx.fillStyle='#111';roundRect(ctx,-W/2-2.5,-H/2+0.4,2,H-0.8,1);ctx.fill();
  drawWindowGlass(ctx,-3,-H/2+2,10,H-4,3);drawWindowGlass(ctx,-W/2+2,-H/2+3,5,H-6,2);
  ctx.fillStyle='rgba(0,0,0,0.6)';roundRect(ctx,W/2-9,-3,4,1.6,0.8);ctx.fill();roundRect(ctx,W/2-9,1.4,4,1.6,0.8);ctx.fill();
  ctx.fillStyle=accent||'#fff';ctx.fillRect(-W/2+3,-2.4,W-7,1.2);ctx.fillRect(-W/2+3,1.2,W-7,1.2);
  drawHeadlights(ctx,W/2-3.5,-H/2+2,2.6,3.2);drawHeadlights(ctx,W/2-3.5,H/2-5.2,2.6,3.2);
  drawTaillights(ctx,-W/2,-H/2+3,2.2,3);drawTaillights(ctx,-W/2,H/2-6,2.2,3);
  drawNumberBadge(ctx,W/2-12,0,num);}

function drawBodyCoupe(ctx,color,wa,num,accent){const W=39,H=16;
  drawWheel(ctx,-W/2+5,-H/2-1,8.5,4.4,0,'#ddd','hub');
  drawWheel(ctx,-W/2+5,H/2-3.4,8.5,4.4,0,'#ddd','hub');
  drawWheel(ctx,W/2-7,-H/2-1,8.5,4.4,wa*0.5,'#ddd','hub');
  drawWheel(ctx,W/2-7,H/2-3.4,8.5,4.4,wa*0.5,'#ddd','hub');
  const g=ctx.createLinearGradient(0,-H/2,0,H/2);
  g.addColorStop(0,lighten(color,55));g.addColorStop(0.5,color);g.addColorStop(1,darken(color,60));
  ctx.fillStyle=g;
  ctx.beginPath();
  ctx.moveTo(-W/2,-H/2+3);ctx.lineTo(-W/2+4,-H/2+1);
  ctx.lineTo(W/2-6,-H/2);ctx.lineTo(W/2,-H/2+5);
  ctx.lineTo(W/2,H/2-5);ctx.lineTo(W/2-6,H/2);
  ctx.lineTo(-W/2+4,H/2-1);ctx.lineTo(-W/2,H/2-3);ctx.closePath();ctx.fill();
  ctx.fillStyle=darken(color,70);
  roundRect(ctx,-W/2-3,-H/2-2,4,H+4,1.5);ctx.fill();
  ctx.fillStyle=accent||'#fff';
  ctx.fillRect(-W/2-3,-H/2-2,4,1.2);ctx.fillRect(-W/2-3,H/2+0.8,4,1.2);
  drawWindowGlass(ctx,-3,-H/2+2,11,H-4,3);
  drawWindowGlass(ctx,-W/2+3,-H/2+3,5,H-6,2);
  ctx.fillStyle=accent||'#fff';
  ctx.fillRect(-W/2+3,-2.4,W-9,1.2);ctx.fillRect(-W/2+3,1.2,W-9,1.2);
  drawHeadlights(ctx,W/2-3.5,-H/2+2.5,2.6,3,'#e0f0ff');
  drawHeadlights(ctx,W/2-3.5,H/2-5.5,2.6,3,'#e0f0ff');
  drawTaillights(ctx,-W/2,-H/2+3.5,2.2,3);drawTaillights(ctx,-W/2,H/2-6.5,2.2,3);
  drawNumberBadge(ctx,W/2-11,0,num);
}

function drawBodyMuscle(ctx,color,wa,num,accent){const W=40,H=21;
