class Track{
  constructor(def){
    if(!def)throw new Error('Track def is required');
    this.name=def.name||'Трасса';this.roadWidth=def.roadWidth||200;this.laps=def.laps||3;
    this.aiSkill=def.aiSkill||0.85;this.points=def.points||[];
    this.waypoints=this.points;
    this.theme=THEMES[def.theme]||THEMES.meadow;this.themeId=def.theme||'meadow';
    this.segments=[];this.cumulative=[0];let total=0;
    for(let i=0;i<this.points.length;i++){
      const a=this.points[i],b=this.points[(i+1)%this.points.length];
      const dx=b.x-a.x,dy=b.y-a.y;const len=Math.hypot(dx,dy)||1;
      this.segments.push({a,b,dx,dy,len,len2:len*len,angle:Math.atan2(dy,dx)});
      total+=len;this.cumulative.push(total);
    }
    this.totalLength=Math.max(1,total);
    this.tunnels=(def.tunnels||[]).map(t=>({
      start:clamp(t.start||0,0,1),end:clamp(t.end||0,0,1),
      width:t.width||0.9,style:t.style||'pipe',
    }));
    const tunnelRanges=this.tunnels.map(t=>({start:Math.min(t.start,t.end),end:Math.max(t.start,t.end)}));
    const TUNNEL_OBSTACLE_MARGIN=0.05;
    const filteredObstacles=(def.obstacles||[]).filter(o=>{
      const p=o.progress||0;
      for(const r of tunnelRanges){
        if(p>=r.start-TUNNEL_OBSTACLE_MARGIN&&p<=r.end+TUNNEL_OBSTACLE_MARGIN)return false;
      }
      return true;
    });
    this.obstacles=filteredObstacles.map(o=>{
      const t=OBSTACLE_TYPES[o.type]||OBSTACLE_TYPES.cone;
      const progress=clamp(o.progress||0,0,1);
      const pt=this.pointAtProgress(progress);
      let segIdx=0;const targetLen=progress*this.totalLength;
      for(let i=0;i<this.segments.length;i++){
        if(targetLen>=this.cumulative[i]&&targetLen<=this.cumulative[i+1]){segIdx=i;break;}
      }
      const seg=this.segments[segIdx]||this.segments[0];
      const perpX=-Math.sin(seg.angle),perpY=Math.cos(seg.angle);
      const maxOff=o.type==='oil'?this.roadWidth*0.22:this.roadWidth*0.32;
      const offset=(o.side||0)*maxOff;
      return Object.assign({},o,{x:pt.x+perpX*offset,y:pt.y+perpY*offset,_used:false},t);
    });
    this.props=[];
    const rng=seededRand(this.points.length*53+11);
    const propKinds=this.theme.props||['tree'];
    for(let i=0;i<80;i++){
      const p=i/80+rng()*0.005;
      const pt=this.pointAtProgress(p);
      let segIdx=0;const tLen=p*this.totalLength;
      for(let j=0;j<this.segments.length;j++){
        if(tLen>=this.cumulative[j]&&tLen<=this.cumulative[j+1]){segIdx=j;break;}
      }
      const seg=this.segments[segIdx]||this.segments[0];
      const perpX=-Math.sin(seg.angle),perpY=Math.cos(seg.angle);
      const off=this.roadWidth*0.68+rng()*280;
      const side=rng()>0.5?1:-1;
      const x=pt.x+perpX*off*side,y=pt.y+perpY*off*side;
      const pr=this.project(x,y);
      if(pr.dist<this.roadWidth*0.62)continue;
      const kind=propKinds[Math.floor(rng()*propKinds.length)];
      const r=PROP_RADIUS[kind]||25;
      const scl=0.9+rng()*0.35;
      this.props.push({x,y,kind,r,seed:rng(),seed2:Math.floor(rng()*10),scale:scl});
    }
    this.decor=[];
    const kinds=this.theme.decor||['bush'];
    let minX=Infinity,minY=Infinity,maxX=-Infinity,maxY=-Infinity;
    for(const p of this.points){minX=Math.min(minX,p.x);maxX=Math.max(maxX,p.x);minY=Math.min(minY,p.y);maxY=Math.max(maxY,p.y);}
    const pad=420;minX-=pad;maxX+=pad;minY-=pad;maxY+=pad;
    for(let i=0;i<300;i++){
      const x=minX+rng()*(maxX-minX),y=minY+rng()*(maxY-minY);
      const p=this.project(x,y);
      if(p.dist<this.roadWidth*0.72)continue;
      const kind=kinds[Math.floor(rng()*kinds.length)];
      const s=0.75+rng()*0.55;
      const seed=rng();const seed2=Math.floor(rng()*10);
      this.decor.push({x,y,kind,seed,scale:s,seed2});
    }
    this.bounds={minX,minY,maxX,maxY};
  }
  project(x,y){
    let bestDist=Infinity,bestProgress=0,bestPx=0,bestPy=0,bestSegIdx=0;
    for(let i=0;i<this.segments.length;i++){
      const s=this.segments[i];
      let t=((x-s.a.x)*s.dx+(y-s.a.y)*s.dy)/s.len2;
      t=clamp(t,0,1);
      const px=s.a.x+s.dx*t,py=s.a.y+s.dy*t;
      const d=Math.hypot(x-px,y-py);
      if(d<bestDist){bestDist=d;bestProgress=(this.cumulative[i]+t*s.len)/this.totalLength;bestPx=px;bestPy=py;bestSegIdx=i;}
    }
    return{dist:bestDist,progress:bestProgress,px:bestPx,py:bestPy,segIdx:bestSegIdx};
  }
  pointAtProgress(p){
    if(!isFinite(p))p=0;
    p=((p%1)+1)%1;
    const target=p*this.totalLength;
    for(let i=0;i<this.segments.length;i++){
      if(target>=this.cumulative[i]&&target<=this.cumulative[i+1]){
        const s=this.segments[i];
        const t=(target-this.cumulative[i])/s.len;
        return{x:s.a.x+s.dx*t,y:s.a.y+s.dy*t};
      }
    }
    return{x:this.points[0].x,y:this.points[0].y};
  }
  getStart(){const a=this.points[0]||{x:0,y:0},b=this.points[1]||a;return{x:a.x,y:a.y,angle:Math.atan2(b.y-a.y,b.x-a.x)};}
  getPath2D(){
    if(this._path)return this._path;
    const p=new Path2D();
    if(this.points.length===0)return p;
    p.moveTo(this.points[0].x,this.points[0].y);
    for(let i=1;i<this.points.length;i++)p.lineTo(this.points[i].x,this.points[i].y);
    p.closePath();
    this._path=p;return p;
  }
  isInTunnel(progress){
    if(!isFinite(progress))return null;
    for(const t of this.tunnels){
      if(t.start<t.end){if(progress>=t.start&&progress<=t.end)return t;}
      else{if(progress>=t.start||progress<=t.end)return t;}
    }
    return null;
  }
}

