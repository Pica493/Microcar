const CAR_R=15;
const BASE_ENGINE=700,BASE_MAX_SPEED=380,BASE_GRIP=9,BASE_TURN=3.2;
const OFFTRACK_TELEPORT_TIME=4.0;

class Car{
  constructor(x,y,angle,isPlayer,isPlayer2,name,num,carDef,color,personality){
    this.x=x;this.y=y;this.angle=angle;this.vx=0;this.vy=0;
    this.isPlayer=isPlayer;this.isPlayer2=isPlayer2||false;
    this.name=name;this.num=num;this.carDef=carDef;
    this.color=color||carDef.color;
    this.accent=carDef.accent||'#fff';this.bodyDraw=carDef.body;this.stats=carDef.stats;
    this.personality=personality||'balanced';
    this.lap=0;this.progress=0;this.prevProgress=0;this.place=1;
    this.finished=false;this.finishTime=0;
    this.wheelAngle=0;this.aiStuckTime=0;this.aiReverseTime=0;
    this.offTrackTime=0;this._inTunnel=null;
    this._mistakeTimer=0;this._mistakeDir=1;this._pushTimer=0;
    this.nextWP=1;
    this.lastGoodX=x;this.lastGoodY=y;this.lastGoodAngle=angle;
    if(isPlayer||isPlayer2){
      this.engineForce=BASE_ENGINE*this.stats.engine;
      this.maxSpeedVal=BASE_MAX_SPEED*this.stats.maxSpeed;
      this.gripVal=BASE_GRIP*this.stats.grip;
      this.turnRate=BASE_TURN*this.stats.turn;
      this.weight=this.stats.weight;
    }else{
      this.engineForce=BASE_ENGINE*0.95;this.maxSpeedVal=BASE_MAX_SPEED*0.95;
      this.gripVal=BASE_GRIP;this.turnRate=BASE_TURN;this.weight=1;
    }
  }
  get speed(){return Math.hypot(this.vx,this.vy);}
  teleportToTrack(){
    this.x=this.lastGoodX;this.y=this.lastGoodY;this.angle=this.lastGoodAngle;
    this.vx=0;this.vy=0;this.offTrackTime=0;
    if(this.isPlayer||this.isPlayer2)Audio.teleport();
  }
  update(dt,throttle,brake,steer,handbrake,track){
    const cos=Math.cos(this.angle),sin=Math.sin(this.angle);
    let vf=this.vx*cos+this.vy*sin;
    let vs=-this.vx*sin+this.vy*cos;
    const DRAG=1.4,BRAKE_FORCE=900,DRIFT_GRIP=3;
    if(throttle>0)vf+=this.engineForce*throttle*dt;
    if(brake>0)vf-=BRAKE_FORCE*brake*dt;
    const grip=handbrake?DRIFT_GRIP:this.gripVal;
    vf*=Math.exp(-DRAG*dt);vs*=Math.exp(-grip*dt);
    const maxSpeed=handbrake?this.maxSpeedVal*0.75:this.maxSpeedVal;
    vf=clamp(vf,-maxSpeed*0.4,maxSpeed);
    const steerFactor=clamp(Math.abs(vf)/100,0,1);
    const dir=vf>=0?1:-1;
    const turnMul=handbrake?1.4:1;
    this.angle+=steer*this.turnRate*steerFactor*dir*turnMul*dt;
    const nc=Math.cos(this.angle),ns=Math.sin(this.angle);
    this.vx=nc*vf-ns*vs;this.vy=ns*vf+nc*vs;
    this.x+=this.vx*dt;this.y+=this.vy*dt;
    const proj=track.project(this.x,this.y);
    const halfRoad=track.roadWidth/2;
    this._inTunnel=track.isInTunnel(proj.progress);
    /* ===== СТЕНЫ ТОННЕЛЯ ===== */
    if(this._inTunnel){
      const tunnelHalfW=(track.roadWidth*(this._inTunnel.width||0.9))/2;
      const dx=this.x-proj.px,dy=this.y-proj.py;
      const d=Math.hypot(dx,dy)||0.0001;
      const allowed=tunnelHalfW-CAR_R*0.5;
      if(d>allowed){
        const nx=dx/d,ny=dy/d;
        const push=d-allowed;
        this.x-=nx*push;this.y-=ny*push;
        const vn=this.vx*nx+this.vy*ny;
        if(vn>0){
          this.vx-=vn*nx*2.0;this.vy-=vn*ny*2.0;
          if((this.isPlayer||this.isPlayer2)&&vn>100){Audio.hit();}
        }
      }
    }
    if(proj.dist<halfRoad*0.7){
      this.lastGoodX=this.x;this.lastGoodY=this.y;this.lastGoodAngle=this.angle;
    }
    if(proj.dist>halfRoad*1.15&&!this._inTunnel){
      this.offTrackTime+=dt;
      const k=Math.exp(-4*dt);this.vx*=k;this.vy*=k;
      if(this.offTrackTime>=OFFTRACK_TELEPORT_TIME){this.teleportToTrack();return;}
    }else{
      this.offTrackTime=0;
      if(proj.dist>halfRoad){const k=Math.exp(-4*dt);this.vx*=k;this.vy*=k;}
    }
    this.prevProgress=this.progress;this.progress=proj.progress;
    const wps=track.waypoints;
    if(wps&&wps.length>1){
      const target=wps[this.nextWP];
      if(target){
        const ddx=this.x-target.x,ddy=this.y-target.y;
        const d2=ddx*ddx+ddy*ddy;
        const R=track.roadWidth*0.7;
        if(d2<R*R){
          if(this.nextWP===0){
            this.lap++;
            if(this.isPlayer&&!this.finished)Audio.lap();
            this.nextWP=1;
          } else {
            this.nextWP=(this.nextWP+1)%wps.length;
          }
        }
      }
    }
    this.wheelAngle=lerp(this.wheelAngle,steer*0.5,1-Math.exp(-12*dt));
  }
  getRaceProgress(){return this.lap+this.progress;}
  draw(ctx){
    ctx.save();ctx.translate(this.x+3,this.y+4);ctx.rotate(this.angle);
    ctx.fillStyle='rgba(0,0,0,0.35)';roundRect(ctx,-19,-11,38,22,6);ctx.fill();ctx.restore();
    ctx.save();ctx.translate(this.x,this.y);ctx.rotate(this.angle);
    const alpha=this._inTunnel?0.75:1;
    ctx.globalAlpha=alpha;
    this.bodyDraw(ctx,this.color,this.wheelAngle,this.num,this.accent);
    if(this.isPlayer2){
      ctx.fillStyle='#00e5ff';ctx.font='bold 8px system-ui';
      ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('P2',0,-14);
    }
    ctx.globalAlpha=1;
    if(this.offTrackTime>0.5&&this.offTrackTime<OFFTRACK_TELEPORT_TIME){
      ctx.fillStyle='rgba(255,120,120,'+(0.5+0.5*Math.sin(performance.now()/150))+')';
      ctx.font='bold 10px system-ui';
      ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText(Math.ceil(OFFTRACK_TELEPORT_TIME-this.offTrackTime)+'с',0,-18);
    }
    ctx.restore();
  }
}

const Input={
  keys:{},stickActive:false,stickId:null,stickDx:0,stickDy:0,
  gasPressed:false,isTouch:false,multiMode:false,
  init(){
    window.addEventListener('keydown',e=>{
      this.keys[e.code]=true;
      if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].indexOf(e.code)>=0)e.preventDefault();
      if(e.code==='Escape'&&(Game.state==='racing'||Game.state==='countdown'))Game.pause();
      if(e.code==='KeyR'&&(Game.state==='racing'||Game.state==='countdown'))Game.restart();
    });
    window.addEventListener('keyup',e=>{this.keys[e.code]=false;});
    window.addEventListener('blur',()=>{this.keys={};});
    this.isTouch=matchMedia('(pointer:coarse)').matches||'ontouchstart' in window;
    const stick=document.getElementById('stick'),knob=document.getElementById('stickKnob'),gasBtn=document.getElementById('gasBtn');
    if(!stick||!knob||!gasBtn)return;
    stick.addEventListener('touchstart',e=>{e.preventDefault();this.stickId=e.changedTouches[0].identifier;this.stickActive=true;this.stickDx=0;this.stickDy=0;},{passive:false});
    window.addEventListener('touchmove',e=>{
      if(this.stickId===null)return;
      for(const t of e.changedTouches){
        if(t.identifier!==this.stickId)continue;
        const r=stick.getBoundingClientRect();
        let dx=t.clientX-(r.left+r.width/2),dy=t.clientY-(r.top+r.height/2);
        const m=Math.hypot(dx,dy),max=r.width*0.4;
        if(m>max){dx=dx/m*max;dy=dy/m*max;}
        this.stickDx=dx/max;this.stickDy=dy/max;
        knob.style.transform='translate('+dx+'px,'+dy+'px)';
      }
    },{passive:false});
    const stickEnd=e=>{
      for(const t of e.changedTouches)if(t.identifier===this.stickId){
        this.stickId=null;this.stickActive=false;this.stickDx=0;this.stickDy=0;
        knob.style.transform='';
      }
    };
    window.addEventListener('touchend',stickEnd);
    window.addEventListener('touchcancel',stickEnd);
    const gs=e=>{e.preventDefault();this.gasPressed=true;gasBtn.classList.add('pressed');};
    const ge=()=>{this.gasPressed=false;gasBtn.classList.remove('pressed');};
    gasBtn.addEventListener('touchstart',gs,{passive:false});
    gasBtn.addEventListener('touchend',ge);
    gasBtn.addEventListener('touchcancel',ge);
  },
  showTouch(on){const tl=document.getElementById('touchLayer');if(tl)tl.classList.toggle('active',on&&this.isTouch);},
  get throttle(){if(this.keys.KeyW)return 1;if(!this.multiMode&&this.keys.ArrowUp)return 1;if(this.gasPressed)return 1;if(this.stickActive&&this.stickDy<-0.2)return 1;return 0;},
  get brake(){if(this.keys.KeyS)return 1;if(!this.multiMode&&this.keys.ArrowDown)return 1;if(this.stickActive&&this.stickDy>0.5)return 1;return 0;},
  get steer(){let s=0;if(this.keys.KeyA)s-=1;if(this.keys.KeyD)s+=1;if(!this.multiMode){if(this.keys.ArrowLeft)s-=1;if(this.keys.ArrowRight)s+=1;}if(this.stickActive&&Math.abs(this.stickDx)>0.15)s=this.stickDx;return clamp(s,-1,1);},
  get handbrake(){return !!this.keys.Space;},
  get throttle2(){if(this.keys.ArrowUp)return 1;return 0;},
  get brake2(){if(this.keys.ArrowDown)return 1;return 0;},
  get steer2(){let s=0;if(this.keys.ArrowLeft)s-=1;if(this.keys.ArrowRight)s+=1;return clamp(s,-1,1);},
  get handbrake2(){return !!(this.keys.Enter||this.keys.ShiftRight||this.keys.Numpad0);},
};

/* ================== ИИ С ХАРАКТЕРАМИ ================== */
const AI_PROFILES={
  aggressive:{
    lookMul:1.15,steerMul:3.0,throttleMul:1.0,
    mistakeChance:0.003,mistakeDur:[0.25,0.7],
    pushChance:0.0008,pushDuration:0.4,canPush:true,
    brakeSkill:1.0,slowdownFactor:0.98,
  },
  pusher:{
    lookMul:1.0,steerMul:2.6,throttleMul:0.96,
    mistakeChance:0.002,mistakeDur:[0.2,0.5],
    pushChance:0.004,pushDuration:0.8,canPush:true,
    brakeSkill:0.85,slowdownFactor:0.94,
  },
  cautious:{
    lookMul:0.9,steerMul:2.6,throttleMul:0.88,
    mistakeChance:0.0008,mistakeDur:[0.15,0.35],
    pushChance:0,pushDuration:0,canPush:false,
    brakeSkill:1.0,slowdownFactor:0.86,
  },
  balanced:{
    lookMul:1.0,steerMul:2.8,throttleMul:0.95,
    mistakeChance:0.0015,mistakeDur:[0.2,0.5],
    pushChance:0.0004,pushDuration:0.4,canPush:true,
    brakeSkill:0.95,slowdownFactor:0.92,
  },
};

const AI={
  think(car,dt,track,game){
    const prof=AI_PROFILES[car.personality]||AI_PROFILES.balanced;
    car._pushTimer=Math.max(0,(car._pushTimer||0)-dt);
    car._mistakeTimer=Math.max(0,(car._mistakeTimer||0)-dt);
    /* Ошибка руления (только если не идёт уже) */
    if(car._mistakeTimer<=0&&Math.random()<prof.mistakeChance){
      const dur=prof.mistakeDur[0]+Math.random()*(prof.mistakeDur[1]-prof.mistakeDur[0]);
      car._mistakeTimer=dur;
      car._mistakeDir=Math.random()<0.5?-1:1;
    }
    const proj=track.project(car.x,car.y);
    const lookahead=(120+car.speed*0.5)*prof.lookMul;
    const lookProgress=proj.progress+lookahead/track.totalLength;
    const lookPoint=track.pointAtProgress(lookProgress);
    let targetX=lookPoint.x,targetY=lookPoint.y;
    const distFromCenter=proj.dist;const halfRoad=track.roadWidth/2;
    if(distFromCenter>halfRoad*0.4){
      const pull=clamp((distFromCenter-halfRoad*0.4)/(halfRoad*0.7),0,1);
      targetX=lerp(lookPoint.x,proj.px,pull*0.9);
      targetY=lerp(lookPoint.y,proj.py,pull*0.9);
    }
    const fx=Math.cos(car.angle),fy=Math.sin(car.angle);
    let avoidX=0,avoidY=0;
    /* препятствия */
    for(const o of track.obstacles){
      if(!o.solid)continue;
      const dx=o.x-car.x,dy=o.y-car.y;
      const ahead=dx*fx+dy*fy;const side=-dx*fy+dy*fx;
      if(ahead<-10||ahead>180)continue;
      const dangerDist=o.r+CAR_R+30;
      if(Math.abs(side)<dangerDist){
        const proximity=(dangerDist-Math.abs(side))/dangerDist;
        const nearness=1-clamp(ahead/180,0,1);
        const push=proximity*nearness*130;
        const sign=side>=0?-1:1;
        avoidX+=-fy*sign*push;avoidY+=fx*sign*push;
      }
    }
    /* кусты, деревья */
    for(const p of track.props){
      const dx=p.x-car.x,dy=p.y-car.y;
      const d2=dx*dx+dy*dy;if(d2>40000)continue;
      const ahead=dx*fx+dy*fy;const side=-dx*fy+dy*fx;
      if(ahead<-20||ahead>150)continue;
      const dangerDist=p.r+CAR_R+25;
      if(Math.abs(side)<dangerDist){
        const proximity=(dangerDist-Math.abs(side))/dangerDist;
        const nearness=1-clamp(ahead/150,0,1);
        const push=proximity*nearness*160;
        const sign=side>=0?-1:1;
        avoidX+=-fy*sign*push;avoidY+=fx*sign*push;
      }
    }
    /* другие машины + попытка «толкнуть» игрока */
    let pushTarget=null;
    for(const other of game.cars){
      if(other===car)continue;
      const dx=other.x-car.x,dy=other.y-car.y;
      const ahead=dx*fx+dy*fy;const side=-dx*fy+dy*fx;
      if(ahead<-10||ahead>120)continue;
      const dangerDist=50;
      if(Math.abs(side)<dangerDist){
        const proximity=(dangerDist-Math.abs(side))/dangerDist;
        const nearness=1-clamp(ahead/120,0,1);
        let push=proximity*nearness*90;
        /* Толкач специально едет в игрока */
        if(prof.canPush&&(other.isPlayer||other.isPlayer2)&&ahead<200&&car._pushTimer<=0){
          if(Math.random()<prof.pushChance){
            car._pushTimer=prof.pushDuration;
            pushTarget=other;
            continue;
          }
        }
        const sign=side>=0?-1:1;
        avoidX+=-fy*sign*push;avoidY+=fx*sign*push;
      }
    }
    if(pushTarget){
      targetX=lerp(targetX,pushTarget.x,0.55);
      targetY=lerp(targetY,pushTarget.y,0.55);
    }
    targetX+=avoidX;targetY+=avoidY;
    const desired=Math.atan2(targetY-car.y,targetX-car.x);
    let diff=desired-car.angle;
    while(diff>Math.PI)diff-=TAU;while(diff<-Math.PI)diff+=TAU;
    let steer=clamp(diff*prof.steerMul,-1,1);
    if(car._mistakeTimer>0){steer=clamp(steer+car._mistakeDir*0.6,-1,1);}
    const absDiff=Math.abs(diff);
    let throttle=prof.throttleMul,brake=0;
    if(absDiff>1.3)throttle*=0.12;else if(absDiff>0.9)throttle*=0.4;else if(absDiff>0.5)throttle*=0.75;
    if(distFromCenter>halfRoad*0.55)throttle*=0.8*prof.slowdownFactor;
    if(absDiff>1.3&&car.speed>230){brake=0.5*prof.brakeSkill;throttle=0;}
    if(car.aiReverseTime>0){car.aiReverseTime-=dt;return{throttle:0,brake:1,steer:-steer};}
    if(car.speed<15&&absDiff>1.2){
      car.aiStuckTime+=dt;
      if(car.aiStuckTime>0.6){car.aiStuckTime=0;car.aiReverseTime=0.55;return{throttle:0,brake:1,steer:-steer};}
    }else car.aiStuckTime=Math.max(0,car.aiStuckTime-dt*2);
    return{throttle,brake,steer};
  }
};

const Particles={
  list:[],
  add(x,y,vx,vy,life,color,size){if(this.list.length>250)return;this.list.push({x,y,vx,vy,life,maxLife:life,color,size});},
  burst(x,y,color,n,speed){for(let i=0;i<n;i++){const a=Math.random()*TAU,s=rand(speed*0.5,speed);this.add(x,y,Math.cos(a)*s,Math.sin(a)*s,rand(0.3,0.6),color,rand(2,4));}},
  update(dt){for(let i=this.list.length-1;i>=0;i--){const p=this.list[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.vx*=0.94;p.vy*=0.94;p.life-=dt;if(p.life<=0)this.list.splice(i,1);}},
  draw(ctx){for(const p of this.list){ctx.globalAlpha=clamp(p.life/p.maxLife,0,1);ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,TAU);ctx.fill();}ctx.globalAlpha=1;},
  clear(){this.list.length=0;},
};
const Ambient={
  list:[],
  reset(theme){this.list.length=0;if(!theme||!theme.ambient)return;const cfg=theme.ambient;for(let i=0;i<cfg.count;i++)this.spawn(cfg);},
  spawn(cfg){
    this.list.push({
      x:Math.random()*Math.max(1,window.innerWidth),y:Math.random()*Math.max(1,window.innerHeight),
      vx:rand(-cfg.speed*0.5,cfg.speed*0.5),vy:rand(cfg.speed*0.5,cfg.speed),
      size:cfg.size*(0.7+Math.random()*0.6),rot:Math.random()*TAU,rotSpd:rand(-2,2),
      life:0,maxLife:rand(3,6),cfg,
    });
  },
  update(dt,theme){
    if(!theme||!theme.ambient){this.list.length=0;return;}
    const cfg=theme.ambient;
    let guard=0;
    while(this.list.length<cfg.count&&guard++<1000)this.spawn(cfg);
    const H=window.innerHeight;
    for(let i=this.list.length-1;i>=0;i--){
      const p=this.list[i];p.life+=dt;
      p.x+=p.vx*dt+Math.sin(p.life*2+i)*20*dt;p.y+=p.vy*dt;p.rot+=p.rotSpd*dt;
      if(p.y>H+20||p.life>p.maxLife){this.list.splice(i,1);this.spawn(cfg);}
    }
  },
  draw(ctx){
    if(!this.list.length)return;
    for(const p of this.list){
      const alpha=clamp(Math.min(p.life*2,p.maxLife-p.life)/1,0,1);
      ctx.globalAlpha=alpha*0.7;ctx.fillStyle=p.cfg.color;
      if(p.cfg.type==='leaves'){ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot);ctx.beginPath();ctx.ellipse(0,0,p.size,p.size*0.5,0,0,TAU);ctx.fill();ctx.restore();}
      else{ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,TAU);ctx.fill();}
    }
    ctx.globalAlpha=1;
  }
};

const Game={
  canvas:null,ctx:null,dpr:1,viewW:0,viewH:0,
  state:'menu',track:null,trackIdx:0,
  cars:[],player:null,player2:null,
  mode:'single',isMulti:false,
  camera:{x:0,y:0,zoom:1},
  countdown:0,raceTime:0,finishDelay:0,
  _lastCountShown:-1,_shake:0,
  _pausedState:null,_platformPaused:false,_adPaused:false,
  _time:0,_lastReward:0,
  _winner:null,
  pauseBtnEl:null,

  init(){
    this.canvas=document.getElementById('game');
    if(!this.canvas){console.error('Canvas #game not found');return;}
    this.ctx=this.canvas.getContext('2d',{alpha:false});
    this.dpr=Math.min(2,window.devicePixelRatio||1);
    this.resize();
    window.addEventListener('resize',()=>this.resize());
    Input.init();
    /* кнопка паузы */
    this.pauseBtnEl=document.getElementById('pauseBtn');
    if(this.pauseBtnEl){
      this.pauseBtnEl.addEventListener('click',()=>{
        if(this.state==='racing'||this.state==='countdown')this.pause();
      });
    }
    document.addEventListener('visibilitychange',()=>{
      if(document.hidden){Audio.mute();if(this.state==='racing'||this.state==='countdown')this.pause();}
      else if(!this._platformPaused)Audio.unmute();
    });
    window.addEventListener('blur',()=>{Audio.mute();if(this.state==='racing'||this.state==='countdown')this.pause();});
    window.addEventListener('focus',()=>{if(!this._platformPaused&&!document.hidden)Audio.unmute();});
  },
  setAdPaused(v){this._adPaused=v;},
  setPlatformPaused(v){
    this._platformPaused=v;
    if(v){if(this.state==='racing'||this.state==='countdown'){this._pausedState=this.state;this.state='paused';}}
    else if(this.state==='paused'&&this._pausedState)this.state=this._pausedState;
  },
  resize(){
    const w=window.innerWidth,h=window.innerHeight;
    this.viewW=w;this.viewH=h;
    if(this.canvas){this.canvas.width=w*this.dpr;this.canvas.height=h*this.dpr;this.canvas.style.width=w+'px';this.canvas.style.height=h+'px';}
  },
  startTrack(trackIdx,mode){
    if(typeof trackIdx!=='number'||trackIdx<0||trackIdx>=TRACKS.length)return;
    Audio.init();Audio.resume();
    this.trackIdx=trackIdx;this.mode=mode||'single';
    this.isMulti=this.mode==='multi';
    Input.multiMode=this.mode==='multi';
    this.track=new Track(TRACKS[trackIdx]);
    Ambient.reset(this.track.theme);
    const start=this.track.getStart();const a=start.angle;
    const c=Math.cos(a),s=Math.sin(a);const nx=-s,ny=c;
    const playerCar=getCarDef(Save.data.currentCar);
    const playerColor=getActualCarColor(playerCar);
    const p2Car=getCarDef('lightning');
    const aiCars=[getCarDef('tank'),getCarDef('dragon'),getCarDef('ghost')];
    const grid=[{back:100,side:60},{back:100,side:-60},{back:35,side:60},{back:35,side:-60}];
    this.cars=[];this._winner=null;
    /* Игрок 1 */
    {
      const g=grid[0];const x=start.x+c*g.back+nx*g.side;const y=start.y+s*g.back+ny*g.side;
      const car=new Car(x,y,a,true,false,'Вы',1,playerCar,playerColor,'player');
      const proj=this.track.project(car.x,car.y);car.progress=car.prevProgress=proj.progress;
      car.nextWP=1;car.lastGoodX=x;car.lastGoodY=y;car.lastGoodAngle=a;
      this.cars.push(car);
    }
    /* Игрок 2 на одном ПК */
    if(this.mode==='multi'){
      const g=grid[1];const x=start.x+c*g.back+nx*g.side;const y=start.y+s*g.back+ny*g.side;
      const car=new Car(x,y,a,true,true,'Игрок 2',2,p2Car);
      const proj=this.track.project(car.x,car.y);car.progress=car.prevProgress=proj.progress;
      car.nextWP=1;car.lastGoodX=x;car.lastGoodY=y;car.lastGoodAngle=a;
      this.cars.push(car);
    }
    /* Боты: разные характеры */
    const personalities=['aggressive','pusher','cautious'];
    const startIdx=this.mode==='multi'?2:1;
    for(let i=startIdx;i<4;i++){
      const g=grid[i];const x=start.x+c*g.back+nx*g.side;const y=start.y+s*g.back+ny*g.side;
      const def=aiCars[i-startIdx]||aiCars[0];
      const personality=personalities[i-startIdx]||'balanced';
      const name=personality==='aggressive'?'ИИ-Агрессор':personality==='pusher'?'ИИ-Толкач':'ИИ-Осторожный';
      const car=new Car(x,y,a,false,false,name,i+1,def,null,personality);
      const proj=this.track.project(car.x,car.y);car.progress=car.prevProgress=proj.progress;car.nextWP=1;
      this.cars.push(car);
