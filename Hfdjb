        car.vx-=vn*nx*1.3;car.vy-=vn*ny*1.3;
        if(car.isPlayer&&Math.abs(vn)>100){this._shake=Math.min(1,this._shake+0.18);Audio.hit();Particles.burst(car.x,car.y,'#a07040',5,120);}
