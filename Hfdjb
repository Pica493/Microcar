    }
    let btns='';
    if(won&&!isLast&&!Game.isMulti)btns+='<button class="btn primary" data-action="nextTrack">▶ Следующая трасса</button>';
    btns+='<button class="btn" data-action="restart">↻ Ещё раз</button>';
    btns+='<button class="btn" data-action="menu">⌂ В меню</button>';
    this.show(
      titleHTML+
      '<div class="stat"><span>Трасса:</span><b>'+Game.track.name+'</b></div>'+
      '<div class="stat"><span>Время:</span><b>'+time+(time!=='—'?' с':'')+(isRecord?' 🏆':'')+'</b></div>'+
      '<div class="stat"><span>Круги:</span><b>'+Game.track.laps+'</b></div>'+
      (!Game.isMulti?'<div class="stat"><span>Награда:</span><b>💰 '+reward+'</b></div>':'')+
      '<div class="coinBar">'+Save.data.coins+'</div>'+
      (won&&!isLast&&!Game.isMulti?'<div class="subtitle" style="color:#7ee8a2;margin-top:10px">🔓 Открыта новая трасса!</div>':'')+
      btns
    );
  },
  onRewardedClick(){
    try{
      if(confirm('Получить бонус 💰 '+REWARD_AD_COINS+' монет?')){
        Save.data.coins+=REWARD_AD_COINS;Save.save();this.showMenu();
      }
    }catch(e){}
  },
};

let _lastT=0;
let _booted=false;
function loop(now){
  if(!_booted)return;
  const dt=Math.min(0.05,(now-(_lastT||now))/1000);
  _lastT=now;
  try{
    const racingStates=['racing','countdown','finished'];
    if(racingStates.indexOf(Game.state)>=0){Game.update(dt);}
    else if(Game.track){Game._time+=dt;Ambient.update(dt,Game.track.theme);}
    if(Game.state!=='menu'&&Game.state!=='campaign'&&Game.state!=='shop'){
      Game.draw();
    } else {
      const ctx=Game.ctx;
      if(ctx){
        ctx.setTransform(Game.dpr,0,0,Game.dpr,0,0);
        ctx.fillStyle='#0a0a1a';ctx.fillRect(0,0,Game.viewW,Game.viewH);
        ctx.strokeStyle='rgba(80,120,180,0.06)';ctx.lineWidth=1;
        for(let x=0;x<Game.viewW;x+=40){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,Game.viewH);ctx.stroke();}
        for(let y=0;y<Game.viewH;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(Game.viewW,y);ctx.stroke();}
      }
    }
  }catch(e){console.error('[Loop error]',e);}
  requestAnimationFrame(loop);
}
function boot(){
  try{
    Save.load();
    Game.init();
    UI.init();
    UI.showMenu();
    _booted=true;
    requestAnimationFrame(loop);
    console.log('[Mini Racers] Ready.');
  }catch(e){
    console.error('[Mini Racers] Boot failed',e);
    document.body.innerHTML='<pre style="padding:20px;color:#f88;font:14px monospace;white-space:pre-wrap">Ошибка запуска:\n'+(e&&e.message)+'\n\n'+(e&&e.stack)+'</pre>';
  }
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);
else boot();
</script>
