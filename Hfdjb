  },
  drawTunnelArch(ctx,p,other,W,outerColor,edgeColor){
    const dx=other.x-p.x,dy=other.y-p.y;const m=Math.hypot(dx,dy)||1;
    const nx=-dy/m,ny=dx/m;
    ctx.strokeStyle=outerColor;ctx.lineWidth=10;
    ctx.beginPath();ctx.moveTo(p.x+nx*W/2,p.y+ny*W/2);ctx.lineTo(p.x-nx*W/2,p.y-ny*W/2);ctx.stroke();
    ctx.strokeStyle=edgeColor;ctx.lineWidth=3;
    ctx.beginPath();ctx.moveTo(p.x+nx*W/2,p.y+ny*W/2);ctx.lineTo(p.x-nx*W/2,p.y-ny*W/2);ctx.stroke();
  },
  drawObstacles(ctx){
    for(const o of this.track.obstacles){
      if(o._used)continue;
      ctx.save();ctx.translate(o.x,o.y);
      ctx.fillStyle='rgba(0,0,0,0.3)';
      ctx.beginPath();ctx.ellipse(3,4,o.r,o.r*0.9,0,0,TAU);ctx.fill();
      if(o.type==='cone'){
        ctx.fillStyle='#c05818';ctx.beginPath();ctx.moveTo(0,-o.r-4);ctx.lineTo(-o.r,o.r);ctx.lineTo(o.r,o.r);ctx.closePath();ctx.fill();
        ctx.fillStyle='#e67e22';ctx.beginPath();ctx.moveTo(-1.5,-o.r-3);ctx.lineTo(-o.r+2,o.r-2);ctx.lineTo(o.r-2,o.r-2);ctx.closePath();ctx.fill();
        ctx.fillStyle='#fff';ctx.beginPath();ctx.moveTo(-o.r*0.35,-o.r*0.15);ctx.lineTo(o.r*0.35,-o.r*0.15);ctx.lineTo(o.r*0.48,o.r*0.12);ctx.lineTo(-o.r*0.48,o.r*0.12);ctx.closePath();ctx.fill();
        ctx.fillStyle='#a04818';roundRect(ctx,-o.r,o.r-5,o.r*2,6,2);ctx.fill();
      } else if(o.type==='tire'){
        ctx.fillStyle='#0a0a0a';ctx.beginPath();ctx.arc(0,0,o.r,0,TAU);ctx.fill();
        ctx.strokeStyle='#2a2a2a';ctx.lineWidth=3;ctx.beginPath();ctx.arc(0,0,o.r-3,0,TAU);ctx.stroke();
        ctx.strokeStyle='#0a0a0a';ctx.lineWidth=2.5;
        for(let i=0;i<12;i++){const a=i*TAU/12;ctx.beginPath();ctx.moveTo(Math.cos(a)*o.r*0.72,Math.sin(a)*o.r*0.72);ctx.lineTo(Math.cos(a)*o.r,Math.sin(a)*o.r);ctx.stroke();}
        ctx.fillStyle='#888';ctx.beginPath();ctx.arc(0,0,o.r*0.45,0,TAU);ctx.fill();
        ctx.fillStyle='#aaa';ctx.beginPath();ctx.arc(0,0,o.r*0.4,0,TAU);ctx.fill();
        ctx.fillStyle='#333';ctx.beginPath();ctx.arc(0,0,o.r*0.15,0,TAU);ctx.fill();
      } else if(o.type==='barrel'){
        const g=ctx.createRadialGradient(-o.r*0.4,-o.r*0.4,2,0,0,o.r);
        g.addColorStop(0,'#e05040');g.addColorStop(1,'#8a2018');ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,o.r,0,TAU);ctx.fill();
        ctx.fillStyle='#f5f5f5';ctx.beginPath();ctx.arc(0,0,o.r*0.9,0,TAU);ctx.arc(0,0,o.r*0.72,0,TAU,true);ctx.fill();
        ctx.strokeStyle='#3a0f0a';ctx.lineWidth=2;ctx.beginPath();ctx.arc(0,0,o.r,0,TAU);ctx.stroke();
        ctx.fillStyle='#7a2018';ctx.beginPath();ctx.arc(0,0,o.r*0.35,0,TAU);ctx.fill();
      } else if(o.type==='oil'){
        const g=ctx.createRadialGradient(0,0,o.r*0.2,0,0,o.r);
        g.addColorStop(0,'rgba(10,8,5,0.95)');g.addColorStop(0.6,'rgba(35,25,10,0.8)');g.addColorStop(1,'rgba(30,20,10,0)');
        ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,o.r,0,TAU);ctx.fill();
        const colors=['rgba(120,80,200,0.5)','rgba(255,200,60,0.45)','rgba(80,220,180,0.45)'];
        for(let i=0;i<3;i++){ctx.strokeStyle=colors[i];ctx.lineWidth=3;ctx.beginPath();ctx.arc(0,0,o.r*(0.25+i*0.15),0.3+i*1.1,2.3+i*1.1);ctx.stroke();}
      }
      ctx.restore();
    }
  },
  /* ============ МИНИКАРТА ============ */
  drawMinimap(ctx){
    const track=this.track;if(!track)return;
    const size=Math.min(120,Math.max(80,this.viewW*0.22));
    const pad=12;
    const x=this.viewW-size-pad;
    const y=pad;
    ctx.save();
    ctx.fillStyle='rgba(0,0,0,0.55)';
    roundRect(ctx,x,y,size,size,10);ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,0.18)';ctx.lineWidth=1;ctx.stroke();
    let minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;
    for(const p of track.points){minX=Math.min(minX,p.x);maxX=Math.max(maxX,p.x);minY=Math.min(minY,p.y);maxY=Math.max(maxY,p.y);}
    const inner=6;
    const tw=maxX-minX||1,th=maxY-minY||1;
    const s=Math.min((size-inner*2)/tw,(size-inner*2)/th);
    const ox=x+(size-tw*s)/2-minX*s;
    const oy=y+(size-th*s)/2-minY*s;
    ctx.beginPath();
    for(let i=0;i<track.points.length;i++){
      const px=ox+track.points[i].x*s;
      const py=oy+track.points[i].y*s;
      if(i===0)ctx.moveTo(px,py);else ctx.lineTo(px,py);
    }
    ctx.closePath();
    ctx.strokeStyle='rgba(60,60,60,0.9)';ctx.lineWidth=5;ctx.stroke();
    ctx.strokeStyle='rgba(255,230,100,0.45)';ctx.lineWidth=1;ctx.setLineDash([3,3]);ctx.stroke();ctx.setLineDash([]);
    const st=track.getStart();
    const fx=ox+st.x*s,fy=oy+st.y*s;
    ctx.fillStyle='#fff';
    ctx.beginPath();ctx.arc(fx,fy,3.5,0,TAU);ctx.fill();
    ctx.strokeStyle='#111';ctx.lineWidth=1;ctx.stroke();
    for(const car of this.cars){
      const cx=ox+car.x*s,cy=oy+car.y*s;
      let col='#ff7676';
      if(car.isPlayer)col='#7ee8a2';
      else if(car.isPlayer2)col='#4f8ef7';
      ctx.fillStyle=col;
      ctx.beginPath();ctx.arc(cx,cy,3,0,TAU);ctx.fill();
      ctx.strokeStyle='#000';ctx.lineWidth=0.6;ctx.stroke();
    }
    ctx.restore();
  },
  /* ============ КОМПАКТНЫЙ HUD ============ */
  drawHUD(ctx){
    if(!this.player)return;
    ctx.save();
    if(this.mode==='multi'&&this.cars[1]){
      this._drawPlayerHUD(ctx,this.cars[0],10,'#e74c3c','P1');
      this._drawPlayerHUD(ctx,this.cars[1],this.viewW-190,'#3498db','P2');
    }else{
      this._drawPlayerHUD(ctx,this.player,10,'#e74c3c','');
    }
    this.drawMinimap(ctx);
    if(this.state==='countdown'){
      ctx.fillStyle='rgba(0,0,0,0.4)';ctx.fillRect(0,0,this.viewW,this.viewH);
      const n=Math.ceil(this.countdown);
      ctx.fillStyle='#fff';ctx.font='bold 160px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';
      ctx.fillText(n>0?String(n):'GO!',this.viewW/2,this.viewH/2);
    }
    ctx.restore();
  },
  _drawPlayerHUD(ctx,player,x,borderColor,label){
    if(!player)return;
    const W=180,H=88;
    ctx.fillStyle='rgba(0,0,0,0.62)';roundRect(ctx,x,10,W,H,10);ctx.fill();
    ctx.strokeStyle=borderColor;ctx.lineWidth=1.6;roundRect(ctx,x,10,W,H,10);ctx.stroke();
    const curLap=Math.min(player.lap+1,this.track.laps);
    ctx.fillStyle=borderColor;ctx.font='bold 11px system-ui';ctx.textAlign='left';ctx.textBaseline='top';
    if(label)ctx.fillText(label,x+8,16);
    ctx.fillStyle='#fff';ctx.font='bold 12px system-ui';
    ctx.fillText('Круг '+curLap+'/'+this.track.laps,x+8+(label?26:0),16);
    ctx.font='bold 20px system-ui';
    ctx.fillStyle=player.place===1?'#f1c40f':'#fff';
    ctx.fillText(player.place+'/'+this.cars.length,x+8,32);
    ctx.font='11px system-ui';ctx.fillStyle='rgba(255,255,255,0.75)';
    ctx.fillText(this.raceTime.toFixed(2)+'с',x+62,38);
    ctx.fillText(this.track.name,x+8,58);
    const barW=W-16;
    ctx.fillStyle='rgba(255,255,255,0.15)';roundRect(ctx,x+8,H-8,barW,5,2.5);ctx.fill();
    ctx.fillStyle=player.speed>player.maxSpeedVal*0.9?'#ff7676':'#7ee8a2';
    roundRect(ctx,x+8,H-8,barW*clamp(player.speed/player.maxSpeedVal,0,1),5,2.5);ctx.fill();
  },
};

const UI={
  el:null,
  _preview:null,
  init(){
    this.el=document.getElementById('ui');
    if(!this.el){console.error('#ui not found');return;}
    this.el.addEventListener('click',e=>{
      try{
        const target=e.target;
        if(!target||!target.closest)return;
        const btn=target.closest('[data-action]');
        if(!btn)return;
        const action=btn.dataset.action;
        if(!action)return;
        e.preventDefault();
        this.handle(action);
      }catch(err){
        console.error('[UI click]',err);
        this.show('<div class="title" style="font-size:28px;color:#ff7676">ОШИБКА</div>'+
          '<div class="status err">'+(err&&err.message?err.message:'Неизвестная ошибка')+'</div>'+
          '<button class="btn primary" data-action="menu">⌂ В меню</button>');
      }
    });
  },
  show(html){
    if(!this.el)return;
    this.el.classList.add('active');
    this.el.innerHTML='<div class="panel">'+html+'</div>';
    this.el.scrollTop=0;
  },
  hide(){if(this.el){this.el.classList.remove('active');this.el.innerHTML='';}},
  handle(action){
    if(action==='menu'){return this.showMenu();}
    if(action==='campaign')return this.showCampaign();
    if(action==='garage')return this.showShop();
    if(action==='together')return this.showTogether();
    if(action==='local2')return this.showLocalPicker();
    if(action==='resume')return Game.resume();
    if(action==='restart')return Game.restart();
    if(action==='rewarded')return this.onRewardedClick();
    if(action==='quick1'){const idx=Math.min(Save.data.unlocked-1,Math.floor(Math.random()*Save.data.unlocked));return Game.startTrack(idx,'single');}
    if(action==='nextTrack'){const next=Game.trackIdx+1;if(next<TRACKS.length)return Game.startTrack(next,Game.mode);return this.showCampaign();}
    if(action.indexOf('track:')===0){const idx=parseInt(action.split(':')[1]);if(!Number.isInteger(idx)||idx<0||idx>=TRACKS.length)return;if(idx>=Save.data.unlocked)return;return Game.startTrack(idx,'single');}
    if(action.indexOf('local2-track:')===0){const idx=parseInt(action.split(':')[1]);if(!Number.isInteger(idx)||idx<0||idx>=TRACKS.length)return;if(idx>=Save.data.unlocked)return;return Game.startTrack(idx,'multi');}
    if(action.indexOf('car:')===0)return this.handleCar(action.split(':')[1]);
    if(action.indexOf('color:')===0){const parts=action.split(':');return this.handleColor(parts[1],parts[2]);}
    if(action==='cancel-preview'){this._preview=null;return this.showShop();}
    if(action==='buy-preview'){
      if(!this._preview)return;
      const parts=this._preview.split(':');const carId=parts[0];const color=parts.slice(1).join(':');
      if(Save.data.coins<COLOR_PRICE){Audio.beep(200,0.2,'square',0.2);return;}
      if(Save.buyColor(carId,color,COLOR_PRICE)){Audio.buy();this._preview=null;this.showShop();}
      else{Audio.beep(200,0.2,'square',0.2);}
      return;
    }
  },
  handleCar(id){
    const car=getCarDef(id);if(!car||car.id!==id)return;
    const s=Save.data;
    this._preview=null;
    if(s.ownedCars.indexOf(id)>=0){s.currentCar=id;Save.save();Audio.beep(660,0.1,'sine',0.15);this.showShop();return;}
    if(s.coins>=car.price){
      s.coins-=car.price;s.ownedCars.push(id);s.currentCar=id;
      Save.save();Audio.buy();this.showShop();
    } else {Audio.beep(200,0.2,'square',0.2);}
  },
  handleColor(carId,color){
    if(!carId||!color)return;
    if(Save.data.ownedCars.indexOf(carId)<0)return;
    if(Save.ownsColor(carId,color)){Save.setColor(carId,color);Audio.beep(660,0.1,'sine',0.15);this._preview=null;this.showShop();return;}
    this._preview=carId+':'+color;
    this.showShop();
  },
  showMenu(){
    Game.state='menu';Input.showTouch(false);
    if(Game.pauseBtnEl)Game.pauseBtnEl.classList.remove('show');
